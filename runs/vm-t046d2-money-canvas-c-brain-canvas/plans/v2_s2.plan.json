 "beats": [
  {
   "beat_id": "b6",
   "say": "पैसा नहीं दिया तो क्या कपड़ा free मिला? नहीं; no use of money है, लेकिन wheat देकर कीमत चुकाई।"
  },
  {
   "beat_id": "b7",
   "say": "अनाज के बदले cycle ठीक करें, तो? यह service, यानी काम का exchange है; barter सिर्फ सामान तक सीमित नहीं।"
  },
  {
   "beat_id": "b8",
   "say": "कितना wheat देकर कितना कपड़ा मिलेगा? Mutual agreement, यानी दोनों की हाँ से तय होगा; अकेला seller नहीं तय करेगा।"
  },
  {
   "beat_id": "b9",
   "say": "यहाँ 2 kg के बदले 1 metre तय हुआ। यह illustrative ratio है, हर जगह का fixed rate नहीं।"
  },
  {
   "beat_id": "b10",
   "say": "Wheat–cloth exchange में पैसा नहीं आता। Definition में goods और services दोनों होने से repair के बदले अनाज भी शामिल है।"
  },
  {
   "beat_id": "b11",
   "say": "सीधा exchange, बिना पैसे, दोनों की हाँ से।"
  }
 ],
