 ],
 "beats": [
  {
   "beat_id": "b36",
   "say": "Salt और note की कीमत कहाँ से आई? मानिए salt packet ₹20 में बिकता और payment में चलता है; note से ₹500 चुकते हैं।"
  },
  {
   "beat_id": "b36a",
   "say": "Payment में लेना बंद हो, तो salt फिर भी उपयोगी और बेचने लायक है; कीमत बदल सकती है। Note का कागज़ ₹500 नहीं दिलाता; यह redemption का वादा नहीं है।"
  },
  {
   "beat_id": "b37",
   "say": "Intrinsic value अपनी चीज़ से है, जैसे सोना। Extrinsic value बाहर के trust और law से है, जैसे note; source में material बनाम government या authority backing का फर्क है।"
  },
  {
   "beat_id": "b38",
   "say": "Inherent worth यानी payment के बाहर उपयोग: salt खाना बनाने में लगेगा। Monetary use हटे तो भी बिकेगा; note का कागज़ ₹500 नहीं दिलाएगा। यहाँ nil का मतलब negligible material value है, valid note की purchasing power नहीं।"
  },
  {
   "beat_id": "b39",
   "say": "Gold, silver, salt, cattle, cowrie shells commodity वाले examples हैं; notes, bank deposits, digital money दूसरे। जैसे account balance में physical सामान नहीं, bank पर payment योग्य claim है।"
  },
  {
   "beat_id": "b40",
   "say": "Salt यहाँ उपलब्ध और उपयोगी है, इसलिए चलता है; बाहर seller मना कर सकता है: वहाँ buyers इसे आगे नहीं लेते। Trusted रुपये वह लेता है क्योंकि उन्हें दूसरी दुकान पर खर्च कर सकेगा।"
  },
  {
   "beat_id": "b41",
   "say": "Divisibility और portability पहले difficult, दूसरे में easy हैं: गाय बाँटने और salt ढोने के मुकाबले छोटा payment आसान है। Note के टुकड़े करना divisibility नहीं।"
  },
  {
   "beat_id": "b42",
   "say": "एक तरफ metal coins और gold bullion, यानी weight और purity वाला सोना। दूसरी तरफ rupee notes, bank balance और UPI; UPI रकम भेजने का रास्ता है, अलग रकम नहीं।"
  },
  {
   "beat_id": "b43",
   "say": "Legal tender कानून में बकाया चुकाता है; trust आगे खर्चने का भरोसा है। छोटे payments और दूरी के लिए divisibility, portability चाहिए। Durability यानी टिकना: commodities generally टिकती हैं; paper खराब होता है, digital technology पर निर्भर है।"
  },
  {
   "beat_id": "b44",
   "say": "Commodity prices बदलते हैं; backing gold redemption नहीं। हर coin intrinsic नहीं; access रुकना balance मिटना नहीं।"
  },
  {
   "beat_id": "b45",
   "say": "अपना उपयोग monetary value नहीं; cattle बीमार पड़ते हैं, salt नमी से बिगड़ता है।"
  }
 ],
