 "beats": [
  {
   "beat_id": "b49",
   "say": "Phone पर Bitcoin payment दिखे तो government-issued money है? नहीं; El-Salvador का example issuance और legal status अलग करता है।"
  },
  {
   "beat_id": "b50",
   "say": "2024 तक El-Salvador में Bitcoin non-fiat legal-tender exception था। इसका mechanism अलग समझिए: नए bitcoin mining से network rules पर बनते हैं; price demand-supply से, government के fixed-value promise से नहीं।"
  },
  {
   "beat_id": "b51",
   "say": "2025 reforms के बाद practical compulsory acceptance हटी; ownership और voluntary use legal रहे। दोनों राज़ी हों तो payment संभव है—यह ban नहीं।"
  },
  {
   "beat_id": "b52",
   "say": "कानूनी recognition बदलने से network का issuer government नहीं बनता।"
  },
  {
   "beat_id": "b53",
   "say": "अलग पूछिए: issuer कौन, ownership legal, acceptance voluntary या compulsory?"
  }
 ],
