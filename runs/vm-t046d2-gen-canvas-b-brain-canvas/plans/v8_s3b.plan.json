 "beats": [
  {
   "beat_id": "b20",
   "say": "लिखी amount face value है; Promise Clause उस face value की RBI guarantee बताता है। Bearer वह है जिसके पास note है, किसी तय व्यक्ति का नाम जरूरी नहीं; इसीलिए मिला हुआ cash अगले payment में चलता है।"
  },
  {
   "beat_id": "b21",
   "say": "इसीलिए zero interest, anonymous bearer bond कहते हैं: interest नहीं, holder का नाम नहीं, इस्तेमाल bearer करता है; promise nominal amount का है।"
  },
  {
   "beat_id": "b22",
   "say": "Negotiable Instruments Act, 1881 के Section 4 extract में promissory note written instrument है, जिसमें unconditional undertaking यानी बिना शर्त वादा हो; ‘not being a bank-note or a currency-note’ इन्हें बाहर रखता है।"
  },
  {
   "beat_id": "b23",
   "say": "‘फसल अच्छी हुई तो दूँगा’ unconditional नहीं है। Bearer bond यहाँ shorthand है, ordinary investment bond नहीं; anonymous से हर transaction untraceable नहीं बनता।"
  },
  {
   "beat_id": "b24",
   "say": "Face value, bearer और legal category अलग रखो; यह पूरी statutory definition नहीं।"
  }
 ],
