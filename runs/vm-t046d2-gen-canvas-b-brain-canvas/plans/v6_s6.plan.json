  {
   "beat_id": "b40",
   "say": "पुरानी price में anna मिले तो? Old system में 1 Rupee = 16 Annas = 64 Paise = 192 Pies; यानी same money के अलग छोटे हिस्से। New system में 100 Paise हैं।"
  },
  {
   "beat_id": "b41",
   "say": "₹1 की same पट्टी को 16, 64 या 192 हिस्सों में सोचो; new में 100 हैं। Equals same value बताता है, coins की same गिनती नहीं।"
  },
  {
   "beat_id": "b42",
   "say": "1957 reform का old/new comparison यही है। पुराने Paise, जिन्हें pice भी कहते हैं, modern decimal paise नहीं; उन्हें मिलाने से conversion गलत होगा।"
  },
  {
   "beat_id": "b43",
   "say": "₹1.25 सीधे 1 rupee और 25 paise बताता है; annas–pies conversion नहीं चाहिए। आसान subdivision से purchasing power अपने-आप नहीं बढ़ती।"
  },
  {
   "beat_id": "b44",
   "say": "64 को 16 से बाँटो तो 1 anna में 4 old paise मिलते हैं; 192 को 64 से बाँटो तो 1 old paisa में 3 pies मिलते हैं। Modern paisa ₹1 का 1/100 है; systems अलग रखो।"
  }
 ],
