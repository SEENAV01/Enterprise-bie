 "beats": [
  {
   "beat_id": "b36",
   "say": "₹100 specimen में ऊपर-नीचे क्या है? दोनों languages का promise ऊपर है और Governor का signature नीचे; अब इन्हें पहचानो।"
  },
  {
   "beat_id": "b37",
   "say": "बाएँ Hindi, दाएँ English में वही ₹100 हैं, ₹200 नहीं। ‘I PROMISE TO PAY’ रकम देने का वादा है; ‘THE BEARER’ यानी note रखने वाले से यह वादा है।"
  },
  {
   "beat_id": "b38",
   "say": "नीचे Raghuram G. Rajan का नाम, signature और Governor title दिखते हैं। यह specimen का signatory है, current-office दावा नहीं; ₹1 पर Finance Secretary sign करते हैं।"
  },
  {
   "beat_id": "b39",
   "say": "Amount, bearer और इस instrument का signatory पहचानो।"
  },
  {
   "beat_id": "b40",
   "say": "इस crop का रास्ता है: दोनों भाषाओं में एक रकम, फिर नीचे signatory।"
  }
 ],
