 "beats": [
  {
   "beat_id": "b55",
   "say": "Banks का आपसी payment और तुम्हारी shopping एक segment हैं? 2022 में wholesale और retail pilots अलग थे; pilot यानी limited trial, ताकि technology और इस्तेमाल जाँच सकें।"
  },
  {
   "beat_id": "b56",
   "say": "e₹-W wholesale interbank settlements, यानी banks के आपसी dues चुकाने के लिए है। October 2022 के announcement context और actual launch को अलग रखो: official start 1 November 2022 है। W institutional segment बताता है, discount नहीं।"
  },
  {
   "beat_id": "b57",
   "say": "दुकान वाली payment किसकी है? December 2022 का e₹-R retail pilot public के लिए था—यानी तुम्हारी sugar खरीद जैसी payment। RBI ने participating banks, merchants और users धीरे-धीरे बढ़ाए।"
  },
  {
   "beat_id": "b58",
   "say": "बदलाव दो use cases की testing है: W banks के settlement का, R public का। दोनों में e electronic form, ₹ rupee और आखिरी letter segment बताता है।"
  },
  {
   "beat_id": "b59",
   "say": "Testing की सीख से participating banks, merchants और users बढ़ते हैं; gradual expansion का मतलब हर दुकान पर availability नहीं है।"
  },
  {
   "beat_id": "b60",
   "say": "क्रम हुआ wholesale official launch 1 November 2022, retail December 2022, फिर expansion। Exam में W को banks, R को public से जोड़ो।"
  },
  {
   "beat_id": "b61",
   "say": "पूरी यात्रा में material, issuer, subdivision, external price और payment form अलग रखो। तभी silver coin, decimal rupee, fiat, managed float और Digital Rupee आपस में नहीं उलझेंगे।"
  }
 ],
