{
 "id": "v6_s2s",
 "part_id": "c14.2",
 "world_width": 5200,
 "beats": [
  {
   "beat_id": "b5",
   "say": "Agra के imaginary बाज़ार में 10 units का कपड़ा है; unfamiliar coins कैसे जाँचोगे? मान लो weights 8 g और 10 g, purity uncertain और checking fee 1 unit है; खर्च 11 हुआ।"
  },
  {
   "beat_id": "b6",
   "say": "मान लो 2 mints ने common purity वाले 10 g coins बनाए हैं। Merchant इन्हें लेता है; checking का 1 unit बचा, इसलिए तुमने 11 नहीं, 10 units दिए।"
  },
  {
   "beat_id": "b7",
   "say": "यही standardization का फायदा है; example के numbers historical नहीं। 1540 में Sher Shah Suri ने silver Rupiya दिया: लगभग 178 grains, यानी 11.5 grams, high purity और empire में uniform standard।"
  },
  {
   "beat_id": "b8",
   "say": "Grains weight की unit है, अनाज नहीं। Weight कुल mass, purity उसमें silver का हिस्सा है; common standard बार-बार तौलने और जाँचने का काम घटाता है।"
  },
  {
   "beat_id": "b9",
   "say": "Empire भर में coins कहाँ बनेंगे? Mughal standardization, 1556–1707 में Akbar ने minting बढ़ाई; hundreds of mints, यानी coin factories, standardized-weight silver coins बनाती थीं।"
  },
  {
   "beat_id": "b10",
   "say": "Emperor का नाम issuing authority बताता था। Company ने 1757–1835 में शुरुआत में familiar Mughal-style coins रखे, लेकिन Bombay, Calcutta और Madras Presidencies अलग coins बनाती थीं।"
  },
  {
   "beat_id": "b11",
   "say": "अलग coins एक जैसे कब हुए? Currency Act of 1835 ने uniform Indian Rupee, standard design और British India में single legal tender दिया—यानी कानून के नियमों से payment चुकाने में accepted पैसा।"
  },
  {
   "beat_id": "b12",
   "say": "Uniformity का मतलब decimalisation नहीं। Queen/King portrait की broad पहचान में याद रखो: original 1835 issue William IV का था, Queen Victoria का नहीं।"
  },
  {
   "beat_id": "b13",
   "say": "Notes कौन जारी करे? Paper Currency Act, 1861 ने British government को exclusive right दिया, यानी एक authorised issuer। Issuance currency बनाता है; lending वापस चुकाने की शर्त वाला loan है।"
  },
  {
   "beat_id": "b14",
   "say": "विदेशी seller को gold दिए बिना कैसे चुकाएँ? Mumbai bank के imaginary ₹10 per £1 rate पर importer के ₹100 से £10 भेजे; sterling reserve £100 से £90, seller receipt £0 से £10 हुई।"
  },
  {
   "beat_id": "b15",
   "say": "Sterling gold-linked हो तो यही indirect bridge Gold Exchange Standard है, domestic gold redemption नहीं। Silver के बदलते भाव के जवाब में Fowler Committee, 1898 ने rupee को gold से जोड़ने की recommendation दी।"
  },
  {
   "beat_id": "b16",
   "say": "1898 timeline marker है; implementation में late-1890s, खासकर 1899 भी याद रखो। ₹10 per £1 historical rate नहीं; exchange link चलाने को reserves और policy चाहिए।"
  }
 ],
