 "beats": [
  {
   "beat_id": "b16",
   "say": "तेल चाहने वाला seller wheat क्यों लेगा? किसान 2 kg wheat देकर 1 metre कपड़ा चाहता है। पहला seller मना करता है; wheat चाहने वाला दूसरा मान जाता है।"
  },
  {
   "beat_id": "b17",
   "say": "इसे double coincidence of wants कहते हैं: मुझे आपकी चीज़ और आपको मेरी चाहिए। सिर्फ एक तरफ की जरूरत काफी नहीं।"
  },
  {
   "beat_id": "b18",
   "say": "ऐसा साथी खोजना मुश्किल है। Accepted पैसे से wheat किसी को बेचें, कपड़ा दूसरे से खरीदें; cloth seller को wheat नहीं चाहिए।"
  },
  {
   "beat_id": "b19",
   "say": "मानिए 2 kg wheat के बदले 1 metre कपड़ा तय किया; गाय के लिए अलग ratio चाहिए। छोटी खरीद में गाय बाँटेंगे कैसे?"
  },
  {
   "beat_id": "b20",
   "say": "अब 2 metres कपड़ा लेकर तय quality का 10 kg अनाज बाद में देना माना। लौटाया 10 kg ही, लेकिन उससे तब 1 metre कपड़ा मिलता है।"
  }
 ],
