ws": [{"cells": ["Goods वही"], "at": 764}, {"cells": ["↓ Spending बढ़ी"], "at": 787}, {"cells": ["↓ Prices बढ़ने का pressure"], "at": 853}, {"cells": ["↓ हर unit से कम खरीद"], "at": 897}], "size": 28, "highlights": [], "x": 0.051, "y": 0.27, "w": 0.5946666666666666, "h": 0.37999999999999995}, {"id": "power", "kind": "value", "tone": "warm", "align": "left", "at": 873, "steps": [{"text": "Example: ₹200 buys 2 baskets", "at": 873}, {"text": "₹200 buys 1 basket", "at": 904, "dir": "down"}], "size": 28, "x": 0.6576666666666666, "y": 0.45157407407407407, "w": 0.2670208333333333, "h": 0.031111111111111114}, {"id": "conclusion", "kind": "callout", "tone": "ok", "style": "note", "align": "left", "at": 915, "text": "Excessive supply रोकना → purchasing power बचाने में मदद", "size": 28, "marks": [{"phrase": "मदद", "at": 1026}], "x": 0.051, "y": 0.6838888888888888, "w": 0.8979999999999999, "h": 0.05222222222222222}, {"id": "done", "kind": "mark", "tone": "ok", "mark": "tick", "pos": "tr", "at": 1053, "target": "anchor"}], "touches": true, "cam": [{"at": 6, "box": {"x": 0.0, "y": 0.0, "w": 1.0, "h": 1.0}, "frames": 30}], "focus": [{"at": 243, "until": 331, "ids": ["anchor", "forecast"]}, {"at": 666, "until": 742, "ids": ["anchor", "guarantee", "ratio"]}, {"at": 966, "until": 1053, "ids": ["anchor", "guarantee", "power", "conclusion"]}]}}], "camera": [{"at": 0}], "captions": [{"at": 12, "until": 331, "text": "Example का evidence यही calculation है: spending दोगुनी, goods वही, इसलिए तय assumptions में price दोगुनी। यह actual prices की forecast नहीं है।"}, {"at": 331, "until": 742, "text": "Limited supply अकेली stable value की guarantee है? नहीं; money की demand और goods-services की availability भी असर डालती हैं। हर money increase से prices उसी ratio में बढ़ें, यह नियम नहीं।"}, {"at": 742, "until": 1061, "text": "कड़ी समझिए: goods वही, spending बढ़ी, prices बढ़ने का pressure, हर unit से कम खरीद। Excessive supply रोकना purchasing power बचाने में मदद कर सकता है।"}]}, {"id": "v1_s4s", "duration": 1405, "camera": [{"at": 0}], "captions": [{"at": 12, "until": 348, "text": "₹500 का किराना कैसे लिया? Wheat देने के बजाय ₹500 दिए; आपके cash ₹500 से ₹0, दुकानदार को मिले cash ₹0 से ₹500। उसे wheat चाहिए या नहीं, पूछना नहीं पड़ा।"}, {"at": 348, "until": 699, "text": "बिना खरीद किए prices कैसे compare करेंगे? Phone ₹20,000, laptop ₹60,000 है। Common rupee scale बताती है: laptop 3 गुना, ₹40,000 महँगा है। अभी payment नहीं हुई।"}, {"at": 699, "until": 1014, "text": "आज की कमाई बाद में कैसे काम आएगी? Worker ने account में ₹500 बचाए; savings ₹0 से ₹500 हुईं। बाद में किराना लिया; saved balance ₹500 से ₹0 हुआ।"}, {"at": 1014, "until": 1380, "text": "Home loan schedule में future payment कैसे लिखेंगे? मानिए अगले महीने ₹10,000 देने हैं। उस date पर payment से unpaid instalment ₹10,000 से ₹0 हुई; future amount पहले तय था।"}], "layers": [{"id": "v1_s4s_world", "type": "block", "block": "world_scene", "at": 0, "box": {"x": 0, "y": 0, "w": 1, "h": 1}, "data": {"world_width": 5200, "elements": [{"id": "shop", "kind": "shop", "x": 2600, "y": 860, "sign": "किराना", "packets": [{"n": 3, "at": 12}, {"n": 2, "at": 120}, {"n": 3, "at": 699}, {"n": 2, "at": 928}], "at": 12}, {"id": "keeper", "kind": "shopkeeper", "x": 2600, "y": 860, "at": 12}, {"id": "function_tracker", "kind": "board", "x": 1750, "y": 290, "text": "Money functions", "fill": "#547B70", "steps": [{"text": "1 Exchange →", "lines": ["1 Exchange →"], "at": 12}, {"text": "1 Exchange ✓", "lines": ["1 Exchange ✓"], "at": 324}, {"text": "1 Exchange ✓\n2 Measure →", "lines": ["1 Exchange ✓", "2 Measure →"], "at": 348}, {"text": "1 Exchange ✓\n2 Measure ✓", "lines": ["1 Exchange ✓", "2 Measure ✓"], "at": 678}, {"text": "1–2 ✓\n3 Save →", "lines": ["1–2 ✓", "3 Save →"], "at": 699}, {"text": "1–2 ✓\n3 Save ✓", "lines": ["1–2 ✓", "3 Save ✓"], "at": 992}, {"text": "1–3 ✓\n4 Future payment →", "lines": ["1–3 ✓", "4 Future payment →"], "at": 1014}, {"text": "1–3 ✓\n4 Future payment ✓", "lines": ["1–3 ✓", "4 Future payment ✓"