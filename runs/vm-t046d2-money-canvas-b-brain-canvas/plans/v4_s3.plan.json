 "beats": [
  {
   "beat_id": "b12",
   "say": "सामान की जगह receipt चले तो? इतिहास में paper claims, सरकारी issue और acceptance rules अलग milestones बने।"
  },
  {
   "beat_id": "b13",
   "say": "Receipt जमा value का सबूत है: 7th century के Tang receipts paper claims दिखाते हैं। 1023 के Song state notes में सरकारी authority issuer बनी; यानी claim के साथ जारी करने वाले की पहचान बदली।"
  },
  {
   "beat_id": "b14",
   "say": "लोग note लेने से मना करें तो? 1275 का Yuan milestone compulsory acceptance है, यानी नियम से लेना ज़रूरी। Sweden के first banknotes 1661 में आए; इसे दुनिया की शुरुआत मत समझिए, Chinese developments पहले हुए।"
  },
  {
   "beat_id": "b15",
   "say": "पैसे का fixed आधार कैसे बने? Britain का 1816 Gold Standard पैसे को तय gold से जोड़ता था। 1944 Bretton Woods में dollar-gold link आया; एक फर्क समझिए: official convertibility थी, हर व्यक्ति का gold counter नहीं।"
  },
  {
   "beat_id": "b16",
   "say": "1971 में gold-redemption link टूटा; दोनों historical sequences इसी modern दौर पर पहुँचते हैं।"
  },
  {
   "beat_id": "b17",
   "say": "अब सवाल है: gold देने का वादा नहीं, तो लोग note क्यों लेंगे?"
  },
  {
   "beat_id": "b18",
   "say": "Paper claims से issuer, acceptance और gold का आधार बदलता गया।"
  }
 ],
