tions": [{"at": 12, "until": 400, "text": "300 BCE और 200 BCE में पहले कौन आया? 300 BCE; BCE में समय आगे बढ़े तो संख्या घटती है। CE में 200 के बाद 300 आता है; BCE और CE dates लिखने के तरीके हैं, इनके बीच year 0 नहीं है।", "beat_id": "b19"}, {"at": 400, "until": 837, "text": "1st century CE में years 1–100 हैं; 20th century में 1901–2000। Dynasty किसी ruling family का समय बताती है, अकेला साल नहीं। मान लो law 2020 में बना, 2021 में लागू हुआ; दोनों dates सही हैं, घटनाएँ अलग हैं।", "beat_id": "b20"}]}, {"id": "v0_s8", "duration": 1917, "camera": [{"at": 0}], "captions": [{"at": 12, "until": 458, "text": "Phone पर ₹100 भरकर button दबाया—क्या app ही पैसा है? App payment interface है, यानी details भरने और काम चुनने की जगह। Pay दबाने पर digital instruction जाता है: किस account से, किसे, कितने पैसे भेजने हैं।", "beat_id": "b22"}, {"at": 458, "until": 987, "text": "PIN या biometric से पहचान या payment की permission जाँची जाती है; यह authentication है। PIN पैसा नहीं, जाँच का तरीका है। Payment पूरा होने पर accounts में entries होती हैं; हिसाब रखने वाला यह record ledger है, जैसे जमा और खर्च की digital बही।", "beat_id": "b23"}, {"at": 987, "until": 1578, "text": "QR scan करना details पढ़ना हो सकता है, instruction भेजना transfer की माँग है, authentication permission की जाँच है और ledger हिसाब रखता है। इसलिए सिर्फ screenshot या button दब जाना completed payment का प्रमाण नहीं; सही transaction status और account record देखना जरूरी है।", "beat_id": "b24"}, {"at": 1578, "until": 1893, "text": "अब खरीद और payment, balance और loan, रकम और purchasing power को अलग रखो। आगे इन्हीं फर्कों से समझेंगे कि Money क्या है और हमारे कौन-से काम करता है।", "beat_id": "b25"}], "layers": [{"id": "v0_s8_world", "type": "block", "block": "world_scene", "at": 0, "box": {"x": 0, "y": 0, "w": 1, "h": 1}, "data": {"world_width": 5200, "elements": [{"id": "bank", "kind": "bank", "x": 2600, "y": 860, "sign": "payment", "at": 12}, {"id": "teller", "kind": "teller", "x": 2600, "y": 860, "at": 12}, {"id": "customer