 "id": "v13_s1",
 "part_id": "c30.1",
 "world_width": 5200,
 "beats": [
  {
   "beat_id": "b1",
   "say": "आपने पूरा bill दिया, फिर दुकानदार को कम पैसे क्यों मिले? Card, voucher और fee को अलग करके समझिए।"
  },
  {
   "beat_id": "b2",
   "say": "Card पर RuPay देखा है? Rupee और Payment जोड़कर नाम बना, यानी 2 टुकड़ों से बना नाम। NPCI ने 2012 में launch किया; यहाँ plus शब्द जोड़ता है, रुपये नहीं।"
  },
  {
   "beat_id": "b3",
   "say": "Jan Dhan खाते के साथ क्या मिलता है? PMJDY में free RuPay debit card, यानी खाते के साथ मिला card। RuPay Credit Cards को UPI से जोड़ना अलग innovation है, जैसे card और payment का रास्ता जोड़ना।"
  },
  {
   "beat_id": "b4",
   "say": "विदेश में नया card कहाँ मिला? Bhutan पहला overseas issuance देश है, 2020 में; Mauritius में शुरुआत 2024 में हुई। Issuance यानी ग्राहक को नया card देना, जैसे खाते के साथ card मिलना।"
  },
  {
   "beat_id": "b5",
   "say": "Nepal और Maldives में ATMs तथा PoS terminals पर acceptance है। यानी cash की machine और दुकान के bill counter पर card चलना। Nepal को acceptance से जोड़िए, card जारी होने के साल से नहीं।"
  },
  {
   "beat_id": "b6",
   "say": "Bhutan में ATMs और merchants पर acceptance भी है। UAE और Singapore में ATMs तथा merchant terminals हैं, यानी दुकानदार की payment लेने वाली machines।"
  },
  {
   "beat_id": "b7",
   "say": "2020 से 2024 में 4 साल का अंतर है; Bhutan पहले, Mauritius बाद में याद रखिए।"
  },
  {
   "beat_id": "b8",
   "say": "इस linkage में payment UPI से शुरू होता है, लेकिन खर्च linked RuPay credit card की borrowing facility से होता है। यानी अपना जमा पैसा नहीं, उधार इस्तेमाल किया और बाद में चुकाना होगा; सामने familiar interface होने से funding नहीं बदलती।"
  },
  {
   "beat_id": "b9",
   "say": "नाम, launch, card type और overseas activity अलग याद रखिए; इससे गलत जोड़ी पकड़ सकेंगे।"
  }
 ],
