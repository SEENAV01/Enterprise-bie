 "beats": [
  {
   "beat_id": "b2",
   "say": "शहर में काम करने वाला व्यक्ति गाँव में घर खर्च भेजना चाहता है; सिर्फ दोनों के पास passbook होने से काम पूरा होगा? मान लीजिए उसके खाते में ₹3,000 हैं, परिवार के खाते में ₹200। जरूरत यह है कि ₹1,000 पहुँचें और परिवार उनसे किराना खरीद सके।"
  },
  {
   "beat_id": "b3",
   "say": "रुकावट कहाँ आ सकती है? अगर पैसे भेजने और पाने के लिए एक ही bank होना जरूरी हो, तो अलग banks वाले परिवार को परेशानी होगी। दोनों तरफ जरूरी access और linked accounts हों, और banks साझा payment व्यवस्था में जुड़े हों, तो यह same-bank जरूरत हट सकती है।"
  },
  {
   "beat_id": "b4",
   "say": "अब व्यक्ति अपने ₹3,000 में से ₹1,000 भेजता है, तो उसके पास ₹2,000 बचते हैं। परिवार के खाते में पहले ₹200 थे; ₹1,000 मिलने पर अब ₹1,200 हैं। परिवार उपलब्ध payment या withdrawal service से पैसे इस्तेमाल करता है; खाता घर की जरूरत पूरी करने का रास्ता बना।"
  }
 ],
