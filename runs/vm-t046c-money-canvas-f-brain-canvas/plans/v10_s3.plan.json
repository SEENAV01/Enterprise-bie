 "beats": [
  {
   "beat_id": "b18",
   "say": "Payment के रास्ते कौन-से हैं? Cheques, UPI, debit cards, NEFT, RTGS और दूसरे channels हैं। Written-instrument family अलग है: Promissory Note, Bill of Exchange, Cheque।"
  },
  {
   "beat_id": "b18a",
   "say": "दुकान का QR scan करते हैं? UPI, यानी Unified Payments Interface, account payment कराता है। Debit card से जुड़े account के पैसे देते हैं। Cheque bank को written payment instruction देता है।"
  },
  {
   "beat_id": "b18b",
   "say": "Transfer form भरते हैं? NEFT, National Electronic Funds Transfer, instructions batches में निपटाता है। RTGS, Real Time Gross Settlement, हर transfer अलग, पूरी रकम का real-time settlement करता है। Balance पैसा है; channel रास्ता है।"
  },
  {
   "beat_id": "b19",
   "say": "Cards की wording देखिए: Promissory Note में “मैं दूँगा”; Bill में “तुम दो”; Cheque में “bank दे।” इसलिए promise, order और bank-directed order पहचान हैं।"
  },
  {
   "beat_id": "b20",
   "say": "Rahul वाला promise है; retailer को ₹1 लाख 90 days बाद देने को कहना order है। UPI और debit cards को इस 3-member family में मत जोड़िए।"
  },
  {
   "beat_id": "b21",
   "say": "Memory trick रखिए: खुद का promise, दूसरे को order, bank को order। तीनों की पहचान मिल गई।"
  }
 ],
