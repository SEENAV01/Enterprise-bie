 "beats": [
  {
   "beat_id": "b28",
   "say": "Supplier payment माँगता है। Drawer को statutory demand notice मिला, यानी कानून के मुताबिक payment की माँग; फिर भी उसने नहीं चुकाया।"
  },
  {
   "beat_id": "b29",
   "say": "Cheque dishonour यानी बिना payment वापसी। Section 138 insufficient funds जैसे कारण और notice के बाद भी non-payment को criminal offence से जोड़ता है।"
  },
  {
   "beat_id": "b30",
   "say": "हर returned cheque अपने-आप crime नहीं बनता। Section 138 की statutory conditions भी पूरी होनी चाहिए।"
  },
  {
   "beat_id": "b31",
   "say": "Supplier बनकर देखिए: payment नहीं मिली, notice भेजा, फिर भी drawer ने नहीं चुकाया।"
  },
  {
   "beat_id": "b32",
   "say": "Return, notice, फिर non-payment याद रखिए; अकेला return पूरा legal test नहीं है।"
  }
 ],
