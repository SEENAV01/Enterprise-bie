 "beats": [
  {
   "beat_id": "b2",
   "say": "खरीदार के ₹100, दुकानदार के ₹0 हैं। खरीदारी के बाद दोनों के balances उलट गए, लेकिन combined cash ₹100 ही रहा।"
  },
  {
   "beat_id": "b3",
   "say": "Money supply economy में एक तय पल पर spending, saving और payments के लिए उपलब्ध money है। Holdings की photo सोचो; यह stock है।"
  },
  {
   "beat_id": "b4",
   "say": "महीने के payments का total यह stock नहीं है। वही ₹100 बार-बार इस्तेमाल हो सकता है।"
  },
  {
   "beat_id": "b5",
   "say": "यानी तय पल की holdings गिनेंगे। Cash और deposits इस्तेमाल करने की आसानी अलग है, इसलिए अलग measures चाहिए।"
  },
  {
   "beat_id": "b5a",
   "say": "Bank के RBI account में ₹100 हैं। RBI उससे ₹100 की security खरीदकर account में जोड़ता है; अब ₹200 हैं। यह बढ़ा balance payments का आधार बनेगा।"
  },
  {
   "beat_id": "b5b",
   "say": "₹2000 में से ₹1000 का certificate खरीदो। किराने के लिए ₹1000 cash बचा; certificate नहीं दोगे। यह भविष्य की बचत National Savings Certificate, यानी NSC है।"
  }
 ],
