 "beats": [
  {
   "beat_id": "b16",
   "say": "किराना दुकान पर ₹1,000 का सामान card से खरीदा; दुकानदार को पूरे पैसे न मिलें तो फर्क कहाँ गया? मान लीजिए card payment लेने की service पर 1% fee है। यह समझाने के लिए मानी गई rate है, आज की लागू rate नहीं।"
  },
  {
   "beat_id": "b17",
   "say": "₹1,000 का 1% हुआ ₹10। Taxes और दूसरे charges छोड़ दें, तो ₹10 कटकर दुकानदार को ₹990 मिलेंगे। ग्राहक की खरीद ₹1,000 की रही; fee दुकानदार के पैसे से गई, ग्राहक को cashback नहीं मिला।"
  },
  {
   "beat_id": "b18",
   "say": "यह merchant-side payment acceptance charge MDR है; पूरा नाम Merchant Discount Rate है। Merchant यानी सामान या service बेचने वाला, जैसे दुकानदार। Customers की card payments लेने के लिए bank merchant पर यह charge लगाता है; उस service में payment infrastructure और processing इस्तेमाल होती है।"
  },
  {
   "beat_id": "b19",
   "say": "IAS-Prelims 2018 ने पूछा: Merchant Discount Rate क्या है? ‘Discount’ सुनकर ग्राहक की छूट मत सोचिए; यहाँ दुकानदार की card payment लेने की cost है। दुकान की net receipt से इसे जोड़िए, लेकिन हमारे 1% से हर card या हर digital payment की rate और exemption तय मत कीजिए।"
  },
  {
   "beat_id": "b20",
   "say": "Option A में bank अपने debit cards की payments लेने पर merchant को incentive देता है। Incentive यानी काम करने के लिए मिलने वाला फायदा या पैसा। यहाँ bank से दुकानदार को पैसे मिलते हैं; MDR में दुकानदार पर charge लगता है, इसलिए A उलटी दिशा बताता है।"
  },
  {
   "beat_id": "b21",
   "say": "Option B में debit card से सामान या service खरीदने वाले customer को bank पैसे वापस देता है। यह cashback जैसा फायदा है, seller की fee नहीं। पूछिए: खरीदार को पैसे वापस मिले या seller के पैसे कटे? B में पहला मामला है, इसलिए B गलत।"
  },
  {
   "beat_id": "b22",
   "say": "Option C के शब्द हैं ‘charge to a merchant by a bank’। किस पर charge है? Merchant पर; कौन लगाता है? Bank। Customers की card payments लेने की service से जुड़ा यही charge हमारे ₹1,000 से ₹990 वाले उदाहरण में दिखा था, इसलिए C सही है।"
  }
 ],
