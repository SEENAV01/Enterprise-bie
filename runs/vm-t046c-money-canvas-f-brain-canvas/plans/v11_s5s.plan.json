 "beats": [
  {
   "beat_id": "b26",
   "say": "अलग banks हों तो दुकान तक payment कैसे पहुँचे? Rahul app से linked account के ₹100 भेजता है; switch instruction सही bank तक पहुँचाता है, जैसे चिट्ठी सही पते पर। Confirmation आती है, दुकानदार को राशन के ₹100 मिलते हैं। यही UPI transaction route है; RBI पीछे settlement framework देखता है।"
  },
  {
   "beat_id": "b27",
   "say": "चाय के ₹20 देने हैं; Rahul के account में ₹500 हैं। Mobile app और linked account से वह PIN डालकर मंज़ूरी देता है; app request भेजती है। PIN अपनी चाबी जैसा secret code है।"
  },
  {
   "beat_id": "b28",
   "say": "Switch banks पहचानता है; Rahul का bank पैसे जाँचता है। पहले ₹500 थे; चाय के ₹20 दिए, अब ₹480 बचे और seller को ₹20 मिले। Merchant के bank को confirmation मिलता है; settlement यानी banks का आपसी बकाया चुकाना, जैसे उधार का हिसाब पूरा करना, RBI की payment infrastructure से होता है।"
  },
  {
   "beat_id": "b29",
   "say": "यही UPI payment process है, जो चाय वाले को payment के पीछे चलता है। Customer का payment experience seconds में होता है; इससे settlement का अलग exact समय तय नहीं होता। यह जिम्मेदारियों का सरल क्रम है, हर technical message की पूरी सूची नहीं।"
  },
  {
   "beat_id": "b40",
   "say": "Daughter अपने mobile से पिता के पैसे कैसे खर्च करे? पिता ₹1000 खर्च करने की permission देते हैं; वह ₹200 का राशन लेती है। पिता के ₹5000 में अब ₹4800 बचे; permission में से ₹200 इस्तेमाल हुए। ₹1000 सिर्फ उदाहरण है, official limit नहीं।"
  },
  {
   "beat_id": "b41",
   "say": "यह UPI Delegated Payments है, August 2024 से जुड़ा feature। Primary user पिता secondary user daughter को अपने account से Rs.X limit तक खर्च की सुविधा देते हैं; X की fixed रकम नहीं दी गई है। यह daughter के deposit account में transfer या नया bank account खोलने की बात नहीं है।"
  },
  {
   "beat_id": "b32",
   "say": "PIN सही, पैसा कम हो तो? चाबी होने से बटुआ भरता नहीं: मंज़ूरी और पैसे की जाँच अलग हैं। Daughter की permission भी खर्च की सीमा है, पूरे account की खुली छूट नहीं।"
  },
  {
   "beat_id": "b33",
   "say": "चाय के ₹20 का run देखिए: मंज़ूरी, request, banks की पहचान, पैसे की जाँच, confirmation; फिर banks का हिसाब चुकाना अलग है। Daughter वाले run में पिता पहले खर्च की permission देते हैं, फिर वह उनके पैसे इस्तेमाल करती है।"
  }
 ],
