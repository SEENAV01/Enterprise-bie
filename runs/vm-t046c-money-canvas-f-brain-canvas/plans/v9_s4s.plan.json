 "beats": [
  {
   "beat_id": "b20",
   "say": "मान लो बाज़ार में ₹10 का चावल लेना है। Government के तय नियम में दोनों coins ₹10 legal payment करते हैं; धातु की कीमत ₹6 और ₹12 है। कौन-सा दोगे?"
  },
  {
   "beat_id": "b21",
   "say": "चुनने की आज़ादी है। तुमने ₹6 की धातु वाला अपना 1 coin दुकानदार को दिया। ₹12 की धातु वाला 1 coin अपने पास रखा। बराबर bill चुकाकर ज्यादा कीमती धातु बची।"
  },
  {
   "beat_id": "b22",
   "say": "यही Gresham's Law है: 'bad money drives out good money', जब दोनों same face value पर legal tender हों। यानी चावल की वही थैली मिलेगी, तो ज्यादा कीमती धातु वाला coin क्यों दोगे?"
  },
  {
   "beat_id": "b23",
   "say": "Intrinsic value यानी धातु की अपनी कीमत। Conditions हैं: दोनों legal tender, government-fixed exchange value, और एक intrinsic value के मुकाबले undervalued। ₹12 की धातु payment में सिर्फ ₹10 गिनी गई।"
  },
  {
   "beat_id": "b24",
   "say": "अब 2 ज्यादा चाँदी वाले और 2 कम चाँदी वाले coins सोचो, सभी ₹10 payment करते हैं। तुमने ज्यादा चाँदी वाले दोनों coins डिब्बे में रख दिए; खर्चने के लिए कम चाँदी वाले coins बचे।"
  }
 ],
