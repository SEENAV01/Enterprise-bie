 "beats": [
  {
   "beat_id": "b28",
   "say": "दोनों coins साथ रखो: common क्या है? बराबर payment value। Good Money और Bad Money यहाँ genuine और counterfeit नहीं, intrinsic value का फर्क हैं।"
  },
  {
   "beat_id": "b29",
   "say": "Good Money का intrinsic value ज्यादा; लोग hoard, यानी जमा रखते, या melt करते हैं। Bad Money का intrinsic value कम; उसे खर्चते हैं।"
  },
  {
   "beat_id": "b30",
   "say": "क्यों? Good Money देकर ज्यादा कीमती धातु जाती है, ज्यादा सामान नहीं मिलता। रखना या melt करना धातु बचाता है; Bad Money वही bill सस्ते में चुकाता है।"
  },
  {
   "beat_id": "b31",
   "say": "इन arrows का मतलब समझो: यानी coin ग्राहक से दुकानदार की cash drawer में, वहाँ से supplier तक जाता है। यह Everyday circulation है; जमा coin डिब्बे में रहता है, दूसरा coin बन नहीं जाता।"
  },
  {
   "beat_id": "b32",
   "say": "याद रखो: ज्यादा intrinsic value वाला बचाया या melt किया; कम वाला खर्चा। जमा coin मौजूद है, बस payments में नहीं घूमता।"
  },
  {
   "beat_id": "b33",
   "say": "Legal rules payment status तय करते हैं; intrinsic value का फर्क spending का चुनाव बदलता है। Exam में नाम नहीं, conditions भी जाँचना।"
  }
 ],
