 "beats": [
  {
   "beat_id": "b21",
   "say": "Indian coins की कतार कैसे पढ़ोगे? बाएँ से दाएँ, ऊपर समय या dynasty, नीचे जुड़ी coinage देखो।"
  },
  {
   "beat_id": "b22",
   "say": "छोटे दबे निशान कैसे बने? Punch-marked में punch से निशान लगते हैं; पहला पड़ाव 6th c. BCE है, यानी छठी century, एक साल नहीं।"
  },
  {
   "beat_id": "b23",
   "say": "अगला silver coin किससे जुड़ा है? Mauryan–Imperial silver, यानी empire से जुड़ी silver coinage; Mauryan को Ashoka की Maurya dynasty से पहचानो।"
  },
  {
   "beat_id": "b24",
   "say": "Design कैसे पड़ा? तीसरा Indo-Greek–Die-struck: design वाले die की चोट metal पर छाप छोड़ती है; यह technique है, metal नहीं। Indo-Greek उत्तर-पश्चिम में Greek-origin rulers थे।"
  },
  {
   "beat_id": "b25",
   "say": "सोने के coins का नाम क्या है? चौथा Gupta–Gold dinars: dinar नाम के gold coins; Gupta को Chandragupta II की dynasty से जोड़ो।"
  },
  {
   "beat_id": "b26",
   "say": "आखिरी silver coin का नाम? 1540 CE–Rupiya, Sher Shah Suri से जुड़ा standardized silver coin; आज के rupee जैसा metal या purchasing power मत मानना।"
  },
  {
   "beat_id": "b27",
   "say": "Matching में association है, ‘केवल यही’ नहीं। बराबर gaps बराबर समय नहीं: century, dynasty और 1540 CE जैसा खास साल अलग labels हैं।"
  },
  {
   "beat_id": "b28",
   "say": "क्रम याद रखो: Punch-marked, Mauryan silver, Indo-Greek Die-struck, Gupta dinars, 1540 का Rupiya; याद का सहारा: निशान, silver, technique, gold, Rupiya।"
  }
 ],
