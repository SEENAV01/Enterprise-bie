 "beats": [
  {
   "beat_id": "b11",
   "say": "Claims बढ़ें, gold नहीं, तो? मान लो US buyer ने French machinery के US$350 दिए। French authority ने banks से ये Dollars लिए; पहले US$350 थे, अब US$700 हैं।"
  },
  {
   "beat_id": "b12",
   "say": "US के पास 10 troy ounces ही हैं, लेकिन पूरे claims चुकाने को 20 चाहिए। Authority US$350 बदलकर 10 ounces ले जाए, तो US का gold खत्म होगा, US$350 का दावा फिर भी बचेगा।"
  },
  {
   "beat_id": "b13",
   "say": "1960s में US ने Vietnam War और welfare programs पर खूब खर्च किया। बाहर Dollars बढ़े, gold कम पड़ा; जैसे रसीदें ज्यादा, पीछे माल कम। इसलिए France ने gold माँगा।"
  },
  {
   "beat_id": "b14",
   "say": "Trade बढ़े तो? मान लो French authority को अब US$700 चाहिए; पहले US$350 थे। उसने export payments के US$350 और लिए। Gold 10 troy ounces रहा, पूरे conversion को 20 चाहिए।"
  }
 ],
