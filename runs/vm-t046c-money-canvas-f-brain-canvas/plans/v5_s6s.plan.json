 "beats": [
  {
   "beat_id": "b30",
   "say": "Oil कम मिले तो? Mumbai का example लो: पहले exporters 100 barrels भेजते थे, अब 60 भेजते हैं। मान लो $1 वाला barrel अब $4 में मिले; 10 barrels के पहले $10 देते थे, अब $40 देंगे।"
  },
  {
   "beat_id": "b31",
   "say": "बेचने-भेजने पर रोक embargo है। 1973 के OPEC oil embargo में prices 4 गुना हुए; Arab exporters की रोक से supply घटी, fuel चाहिए रहा।"
  },
  {
   "beat_id": "b32",
   "say": "4 गुना यानी 300% increase, 400% नहीं। Supply घटने से ठीक 4 गुना price होना कोई formula नहीं।"
  },
  {
   "beat_id": "b33",
   "say": "Oil के Dollars कहाँ जाएँ? मान लो Saudi seller $100 पाए, नए Treasury issue में $60 लगाए, $40 रखे; सरकार $60 उधार पाए।"
  },
  {
   "beat_id": "b34",
   "say": "यह receipts का investment है। 1974 में Saudi Arabia ने Dollar oil-pricing और revenues का बड़ा हिस्सा US Treasury securities तथा American financial markets में लगाना माना; 60/40 सिर्फ example है।"
  }
 ],
