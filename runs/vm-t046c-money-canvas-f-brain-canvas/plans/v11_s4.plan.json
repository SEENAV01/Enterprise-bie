  {
   "beat_id": "b20",
   "say": "Phone से दुकानदार तक request कैसे पहुँचेगी? इसमें app, आपका bank, जोड़ने वाला switch और दुकानदार का bank हैं—जैसे संदेश पहुँचाने के अलग counters।"
  },
  {
   "beat_id": "b21",
   "say": "बाएँ Rahul app पर PIN डालकर request भेजते हैं। अगला box Rahul's Bank है, यानी उनकी passbook वाला bank; यह app और NPCI के बीच है।"
  },
  {
   "beat_id": "b22",
   "say": "बीच में NPCI का switch है, जैसे सही पते की तरफ चिट्ठी भेजने वाला sorting counter। इसके दाएँ आखिरी box Merchant's Bank है, यानी दुकानदार का bank; switch से निकला arrow इसी receiving side पर पहुँचता है।"
  },
  {
   "beat_id": "b23",
   "say": "Rahul का bank उपलब्ध funds जाँचता है, switch दोनों banks पहचानकर request भेजता है, और merchant का bank confirmation पाता है। जैसे चिट्ठी पहुँचाने वाला आपका पैसा नहीं रखता, switch भी deposit account नहीं है।"
  },
  {
   "beat_id": "b24",
   "say": "दोनों banks को NPCI की routing जोड़ती है; संदेश वहाँ से गुजरता है, customer deposit नहीं रखा जाता। मगर संदेश पहुँचाना और banks का आपसी बकाया चुकाना अलग काम हैं। RBI पीछे settlement framework की oversight करता है, इसलिए वह पाँचवाँ routing box नहीं है।"
  },
  {
   "beat_id": "b25",
   "say": "नक्शा याद रखिए: app, payer bank, switch, merchant bank; RBI की oversight पीछे है।"
  }
 ],
