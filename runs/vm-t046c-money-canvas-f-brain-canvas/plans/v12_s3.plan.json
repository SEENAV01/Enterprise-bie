 "world_width": 5200,
 "beats": [
  {
   "beat_id": "b17",
   "say": "इन 4 options में समान क्या है? चारों 24×7, all days खुले हैं; रविवार की availability से अकेले चुनाव नहीं होगा।"
  },
  {
   "beat_id": "b18",
   "say": "NEFT, National Electronic Funds Transfer है; RTGS, Real-Time Gross Settlement है। IMPS, Immediate Payment Service और UPI, Unified Payments Interface है। Interface यानी payment से जुड़ने का रास्ता, जैसे phone की screen।"
  },
  {
   "beat_id": "b19",
   "say": "NEFT और RTGS को RBI से, IMPS और UPI को NPCI से जोड़िए। लेकिन network चलाने वाला operator और ऊपर से देखरेख करने वाला regulator अलग हैं; RBI का overarching regulatory role है।"
  },
  {
   "beat_id": "b20",
   "say": "NEFT batch में है, इसलिए अगला round आने तक धीमा पड़ सकता है। RTGS real-time gross है; IMPS और UPI भी real-time बताए जाते हैं। आखिरी तीनों की speed instant है; RTGS का जोर high-value पर है।"
  },
  {
   "beat_id": "b21",
   "say": "RTGS की minimum ₹2 lakh है; ₹50000 उस दरवाजे से नहीं गुजरेंगे। NEFT, IMPS और UPI की minimum row में ‘No minimum’ है।"
  },
  {
   "beat_id": "b22",
   "say": "NEFT की fixed maximum नहीं; RTGS की upper limit नहीं। IMPS में ₹5 lakh, bank-wise फर्क के साथ है। UPI में ₹1 lakh default और Person-to-Merchant के लिए ₹10 lakh है; इसे conditions वाला दरवाजा समझिए।"
  },
  {
   "beat_id": "b23",
   "say": "NEFT regular, RTGS बड़ी urgent और IMPS रोजमर्रा की urgent payment के लिए है। UPI mobile-based peer-to-peer, जैसे दोस्त को पैसे, और merchant, जैसे दुकान को payment के लिए है।"
  },
  {
   "beat_id": "b24",
   "say": "NEFT और RTGS के रास्ते internet तथा mobile banking हैं; IMPS में ATM भी है। UPI में GPay, PhonePe जैसे apps हैं—सामने का रास्ता, पीछे का system नहीं।"
  },
  {
   "beat_id": "b25",
   "say": "Availability यानी दुकान का दरवाजा खुला है; speed यानी काम में कितना इंतजार है। Gross में हर bill पूरा अलग चुकता है, सिर्फ हिसाब का अंतर नहीं; IMPS-UPI में तुरंत पैसे मिलना पूरा interbank हिसाब नहीं बताता।"
  },
  {
   "beat_id": "b26",
   "say": "‘हर merchant payment ₹10 lakh तक’ गलत है: eligible category और लागू conditions चाहिए, सिर्फ merchant QR नहीं। Bank की limit भी पूरे system की limit नहीं है।"
  },
  {
   "beat_id": "b27",
   "say": "इस table को काम, settlement, speed, limits और channel से पढ़िए। खास trap: 24×7 मतलब instant नहीं; RTGS की ₹2 lakh minimum है।"
  }
 ],
