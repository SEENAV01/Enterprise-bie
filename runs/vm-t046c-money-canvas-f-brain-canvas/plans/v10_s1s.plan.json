 "beats": [
  {
   "beat_id": "b2",
   "say": "बिना नोट निकाले ₹200 का किराना कैसे लेंगे? आपके ₹1,000 थे, दुकानदार के ₹500। Account payment के बाद आपके ₹800 बचे, उसके ₹700 हुए।"
  },
  {
   "beat_id": "b3",
   "say": "उधार का दावा आगे कैसे जाएगा? Retailer का ₹10,000 चुकाने वाला valid written document wholesaler ने नियम से supplier को दिया। अब वह 1 document supplier के पास है।"
  },
  {
   "beat_id": "b4",
   "say": "खुद चुकाने का वादा कैसा दिखेगा? मानिए Rahul ने ₹50,000 के चावल उधार दिए। Retailer लिखता है, “I promise to pay Rahul ₹50,000 on 1 January.” चुकाने पर बकाया ₹0 होगा।"
  },
  {
   "beat_id": "b5",
   "say": "दूसरे को चुकाने को कहें तो? Wholesaler retailer को ₹1 लाख 90 days बाद देने का written order देता है। मानिए समय पर पूरा चुकाया; बकाया ₹0 हुआ।"
  },
  {
   "beat_id": "b6",
   "say": "Bank को लिखें तो? ₹2,000 के किराने का cheque दुकानदार जमा करता है। सफल clearing पर आपके ₹10,000 में ₹8,000 बचे; उसके ₹5,000 बढ़कर ₹7,000 हुए। केवल cheque देने से नहीं।"
  }
 ],
