 "world_width": 5200,
 "beats": [
  {
   "beat_id": "b23",
   "say": "मानिए आपने ₹100 के चावल खरीदे और ₹100 का 1 note दिया। दुकानदार को उसके नकली होने का शक हुआ; उसने note लौटाकर दूसरा payment माँगा, क्योंकि आगे कोई उसे न ले तो नुकसान होगा। यही counterfeiting से भरोसा टूटने का रास्ता है।"
  },
  {
   "beat_id": "b24",
   "say": "इस बदलाव की जरूरत क्यों पड़ी? Deccan और Central Asia के युद्धों में भारी खर्च था, treasury में silver कम था। Administration और trade के payments भी चलाने थे।"
  },
  {
   "beat_id": "b25",
   "say": "1329–1330 CE में सस्ते coins की face value silver Tanka बराबर की गई। हर payment के लिए silver न जुटाना पड़े, इसलिए यह रास्ता चुना। मकसद money supply बढ़ाकर युद्ध, administration और trade चलाना था; coins बढ़ने से सामान खुद नहीं बढ़ता।"
  },
  {
   "beat_id": "b26",
   "say": "Copper coins की copy आसान थी; नकली coins फैल गए। Minting यानी coins बनाना और पहचान के निशान देना। Secure minting की कमी से असली-नकली अलग करना मुश्किल हुआ; असली coin पर भी doubt होने लगा।"
  },
  {
   "beat_id": "b27",
   "say": "Enforcement की कमजोरी अलग थी: सरकार नकली coins बनना और चलना रोक नहीं सकी। पहचान का system कमजोर होना और नियम लागू न कर पाना अलग समस्याएँ हैं; दोनों ने आगे acceptance का भरोसा घटाया।"
  },
  {
   "beat_id": "b28",
   "say": "भरोसा टूटने का सबूत क्या था? व्यापारियों और लोगों ने coins लेने से मना किया: आगे कोई न ले तो वे सामान क्यों दें? 4 बातें जुड़ी थीं: counterfeiting, secure minting की कमी, कमजोर enforcement और public confidence टूटना।"
  },
  {
   "beat_id": "b29",
   "say": "शुरू की दुकान में note जाँचना और फिर स्वीकार करना याद है? वही public trust का practical रूप है: आज मिला पैसा आगे भी चलेगा। Tughlaq के प्रयोग में refusal दिखाता है कि यह भरोसा बच नहीं पाया।"
  },
  {
   "beat_id": "b30",
   "say": "अगर coins ज्यादा हों लेकिन दुकानदार उन्हें ले ही न, तो क्या usable money बढ़ा? जरूरी नहीं। सस्ती metal से सफलता या failure तय नहीं होता; public trust और effective regulation, यानी सच में काम करते नियम, जरूरी हैं।"
  },
  {
   "beat_id": "b31",
   "say": "सही statement चुनिए: 1, तय payment value बराबर तो metal value भी बराबर; 2, पहचान और enforcement की कमजोरी अलग हैं; 3, refusal अकेले treasury loss साबित करता है। केवल 2 सही है: 1 में बराबरी का आधार गलत है; 3 में खजाने से payment साबित नहीं हुआ।"
  }
 ],
