   "say": "तीन boxes कैसे पढ़ेंगे? Customer से Merchant, फिर Banks & Payment Network; यह payment और fee अलग दिखाता है।"
  },
  {
   "beat_id": "b60",
   "say": "बाएँ buyer है; Pays ₹1,000 arrow seller तक जाती है। यह खरीदारी की पूरी रकम है, fee नहीं।"
  },
  {
   "beat_id": "b61",
   "say": "बीच के Merchant में payment आती है; MDR shared arrow दाएँ निकलती है। Seller के पास ₹980 रहते हैं।"
  },
  {
   "beat_id": "b62",
   "say": "दायाँ box कई recipients को समेटता है: दोनों banks, network और applicable provider; एक organisation नहीं।"
  },
  {
   "beat_id": "b63",
   "say": "2% यानी हर ₹100 पर ₹2; ₹1,000 पर ₹20 कटे, इसलिए ₹980 मिले। Percent rate है, रुपये receipt हैं।"
  },
  {
   "beat_id": "b64",
   "say": "₹20 total fee है, हर recipient का हिस्सा नहीं; 2% इसी example की rate है, universal नहीं।"
  },
  {
   "beat_id": "b65",
   "say": "चित्र definition खोलता है: buyer payment करता है, merchant fee देता है, participants उसे share करते हैं।"
  },
  {
   "beat_id": "b66",
   "say": "अंत में तीन पहचान अलग रखिए: RuPay card brand, e-RUPI restricted voucher, MDR merchant की fee। एक सेवा पर रोक समझाता है, दूसरा net receipt।"
  }
 ],
