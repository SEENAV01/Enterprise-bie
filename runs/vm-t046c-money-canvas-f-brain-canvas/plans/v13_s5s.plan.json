 "beats": [
  {
   "beat_id": "b25",
   "say": "सरकार आपकी ₹1,000 की COVID vaccination कराना चाहे तो? मान लीजिए खाते में पैसे भेजने के बजाय आपके लिए ₹1,000 का voucher SMS या QR code से भेजती है।"
  },
  {
   "beat_id": "b26",
   "say": "आप authorised centre पर वही voucher देकर vaccination लेते हैं। पूरे ₹1,000 की सेवा मिलने पर ₹0 बाकी हैं; cash निकालना या दूसरी खरीदारी करना allowed नहीं है।"
  },
  {
   "beat_id": "b27",
   "say": "यही e-RUPI है, 2021 से जुड़ा SMS / QR Code based Prepaid Cashless Electronic Voucher। National Payments Corporation of India, यानी NPCI ने इसे अपने UPI platform पर बनाया; phone इसका delivery माध्यम (medium) है।"
  },
  {
   "beat_id": "b28",
   "say": "Prepaid यानी value पहले funded; cashless यानी सेवा लेते समय cash नहीं देते। Person-specific यानी तय व्यक्ति; purpose-specific यानी तय काम, जैसे आपकी vaccination।"
  },
  {
   "beat_id": "b29",
   "say": "खाते में खुले खर्च के ₹1,000 आना इसका उदाहरण नहीं; voucher में इस्तेमाल की शर्तें रहती हैं।"
  }
