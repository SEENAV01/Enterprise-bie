 "beats": [
  {
   "beat_id": "b5",
   "say": "काम की financial सेवाएँ लोगों तक पहुँचना और उनका इस्तेमाल कर पाना, यही financial inclusion है। NPCI, यानी National Payments Corporation of India, देश की retail payment व्यवस्था से जुड़ी organisation है। साझा payment रास्ते accounts को काम का बनाते हैं, इसलिए NPCI financial inclusion बढ़ाने में मदद करता है।"
  },
  {
   "beat_id": "b6",
   "say": "इस उदाहरण से क्या पता चला? अलग banks के बीच payment का रास्ता मिला, तो परिवार खाता इस्तेमाल कर पाया। घर पैसे भेजते समय यही जरूरत होती है; इससे पूरे देश में inclusion कितना बढ़ा, यह नहीं मापा गया।"
  },
  {
   "beat_id": "b7",
   "say": "Claim है ‘helps in promoting’, न कि ‘अकेले सबको शामिल कर देता है’। Connectivity न हो, service महँगी हो या व्यक्ति इस्तेमाल न कर पाए, तो रास्ता होते हुए भी काम रुकेगा। यहाँ न numerical measure है, न सबके शामिल होने की guarantee।"
  },
  {
   "beat_id": "b8",
   "say": "यह कारण की कड़ी याद रखिए: साझा payment रास्ता, फिर खाते में पैसा भेजना-पाना आसान, फिर खाते का असली इस्तेमाल। इसी तरह infrastructure inclusion में मदद करता है। मदद और पूरी guarantee को एक मत मानिए।"
  }
 ],
