 "beats": [
  {
   "beat_id": "b11",
   "say": "ये scale और transport limitations हैं। Limited supply यानी खरीद बढ़ते ही नया metal नहीं मिलता; payment के साधन बढ़ाना मुश्किल होता है।"
  },
  {
   "beat_id": "b12",
   "say": "घिसा coin देखा? Wear and tear से वजन या छाप घटती है। अब मान लो, उसी denomination के coin में पहले 10 gram silver था; बनाने वाले ने जानबूझकर सिर्फ 8 gram रखा। यह coin debasement है: बताई कीमत के मुकाबले कीमती metal घटाना, अपने-आप घिसना नहीं।"
  },
  {
   "beat_id": "b13",
   "say": "कम metal, भारी ढुलाई, चोरी और coin की quality की मुश्किलों ने बड़े व्यापार को संभालना कठिन बनाया; इसलिए paper money अपनाने की जरूरत बनी।"
  },
  {
   "beat_id": "b14",
   "say": "Paper भी चोरी हो सकता है। Gold देने का वादा हो, तो paper जारी करते समय वह वादा निभाने की क्षमता चाहिए।"
  },
  {
   "beat_id": "b15",
   "say": "कड़ी पकड़ो: आसान payment, बढ़ता व्यापार, फिर metal की सीमाओं से paper की जरूरत।"
  }
 ],
