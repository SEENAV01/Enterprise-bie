 "world_width": 5200,
 "beats": [
  {
   "beat_id": "b6",
   "say": "इस तस्वीर में customer कहाँ है? Payment ecosystem के role map में ऊपर RBI, फिर NPCI, नीचे Banks, Payment Apps और Users हैं। यानी आपकी payment screen के पीछे अलग जिम्मेदारियों वाले कई participants हैं।"
  },
  {
   "beat_id": "b7",
   "say": "ऊपर RBI regulator है, यानी नियम और oversight देखने वाली authority; नीचे NPCI systems चलाता है। Connector RBI से NPCI, फिर बीच के Payment Apps box तक है; Banks और Users तक अलग arrows नहीं हैं। दोनों की जिम्मेदारी अलग पहचानिए: oversight करना और व्यवस्था चलाना।"
  },
  {
   "beat_id": "b8",
   "say": "QR scan करके ₹150 देना UPI का उदाहरण है; holiday पर तुरंत ₹2000 भेजना IMPS का। UPI यानी Unified Payments Interface, IMPS यानी Immediate Payment Service: speed मिलती है, पर दोनों अलग arrangements हैं।"
  },
  {
   "beat_id": "b9",
   "say": "Card से दुकान पर payment करें तो RuPay एक Indian card network है। गाँव में bank के business correspondent की micro-ATM पर Aadhaar authentication से ₹500 निकालना AePS, यानी Aadhaar Enabled Payment System है।"
  },
  {
   "beat_id": "b10",
   "say": "बहुत से accounts में पैसे भेजने या authorised EMI collection के लिए NACH, National Automated Clearing House, bulk credits और debits देता है। NPCI के 5 नाम हैं UPI, IMPS, RuPay, AePS और NACH—5 एक जैसी apps नहीं।"
  },
  {
   "beat_id": "b11",
   "say": "Account कौन रखता है? Banks accounts और settlement सँभालते हैं, यानी banks का आपसी हिसाब चुकाना। Payment Apps box में UPI apps और gateways हैं; gateway online checkout से request आगे भेजने का दरवाजा समझिए।"
  },
  {
   "beat_id": "b12",
   "say": "Users कौन हैं? नीचे दाएँ Users box में consumers और merchants हैं: राशन खरीदने वाले आप consumer, पैसे लेने वाला दुकानदार merchant।"
  },
  {
   "beat_id": "b13",
   "say": "मुख्य बात: regulator, operator, bank, interface और user अलग roles हैं। Phone की payment screen को deposit रखने वाला bank मत समझिए।"
  },
  {
   "beat_id": "b14",
   "say": "यह roles का map है: ऊपर oversight और operation, नीचे accounts, interfaces और users।"
  }
 ],
