 "beats": [
  {
   "beat_id": "b32",
   "say": "Flow की शुरुआत कहाँ है? Silver Tanka पर, जिसे Established Currency कहा गया है: यानी पहले से चल रहा पैसा। यही reference है जिसके सामने नया payment arrangement आया।"
  },
  {
   "beat_id": "b33",
   "say": "Financial loss का रास्ता समझने के लिए मानिए सरकार ने 10 नकली tokens लिए और हर token के बदले 1 silver unit दिया। खजाने से 10 units निकल गए, जबकि ये tokens सरकार ने जारी ही नहीं किए थे। यह केवल conditional example है, historical redemption rule नहीं।"
  },
  {
   "beat_id": "b34",
   "say": "Arrows में breakdown की जगह देखिए। पहला खाना established Silver Tanka है; Counterfeiting & Loss of Trust तक arrow नए tokens से आता है, और वहाँ से Withdrawal & Huge Financial Loss तक जाता है। इसलिए भरोसा टूटना और अंतिम financial outcome अलग stages हैं।"
  },
  {
   "beat_id": "b35",
   "say": "पहचान मुश्किल हो तो असली token भी ठुकराया जा सकता है; acceptance बचाना जरूरी था। Private payment रुकना और treasury से silver निकलना अलग हैं। Historical outcome बड़ा नुकसान था, हमारे example की रकम नहीं।"
  },
  {
   "beat_id": "b37",
   "say": "पूरा flow जोड़िए: established silver Tanka, 1329–1330 CE में brass और copper tokens, फिर counterfeiting और भरोसा टूटना, अंत में withdrawal और बड़ा financial loss। पैसा केवल metal या सरकारी आदेश से नहीं चलता; authenticity, भरोसा और effective control चाहिए। आगे note की पहचान और उसका promise समझेंगे।"
  }
 ],
