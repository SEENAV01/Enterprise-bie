 "beats": [
  {
   "beat_id": "b13",
   "say": "मानिए आपके पास ₹100 हैं; सारा पैसा चावल वाले को दिया, अब कुछ नहीं बचा। उसके पास पहले कुछ नहीं था, अब ₹100 हैं। वह वही note देकर ₹100 के प्याज लेता है; अब पैसा प्याज वाले के पास है।"
  },
  {
   "beat_id": "b14",
   "say": "इसी को modern fiat currency समझिए: note से चावल इसलिए मिला क्योंकि आगे प्याज वाला भी उसे लेता है, कागज़ की कीमत से नहीं। पुराने copper और brass coins के सामने आज paper और digital money हैं।"
  },
  {
   "beat_id": "b15",
   "say": "Silver Tanka intrinsically valuable था, यानी silver की अपनी कीमत थी; tokens की face value royal order पर थी। Slash brass या copper दिखाता है, equals sign payment की बराबरी; वजन या metal value की नहीं।"
  },
  {
   "beat_id": "b16",
   "say": "सुरक्षा में फर्क देखिए: Tughlaq के anti-counterfeit उपाय कमजोर थे। Modern fiat में State और Central Bank backing तथा advanced security features हैं; backing को silver में बदलने की guarantee मत समझिए।"
  },
  {
   "beat_id": "b17",
   "say": "वजह material अकेला नहीं है। सामान देने वाला आगे खर्च करने लायक पैसा चाहता है। पुराने प्रयोग में भरोसा टूटा; modern व्यवस्था institutional credibility, यानी पैसा संभालने वाले system पर भरोसे से चलती है।"
  },
  {
   "beat_id": "b18",
   "say": "Tughlaq ने tokens वापस लेकर copper coins के बदले silver देने दिया। इससे treasury पर बोझ क्यों पड़ा? Cash box में 100 silver Tankas मानिए; 20 देने पर 80 बचे। लौटी सस्ती metal, लेकिन खर्च के लिए रखा कीमती silver घटा।"
  }
 ],
