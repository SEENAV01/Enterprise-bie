 "beats": [
  {
   "beat_id": "b3",
   "say": "French authority Dollars देकर क्या पाएगी? मान लो उसने US$350 के claims सौंपे और बदले में 10 troy ounces gold लिया।"
  },
  {
   "beat_id": "b4",
   "say": "यही fixed gold convertibility है: यानी US$35 देकर 1 troy ounce gold लेना। वादा खासकर foreign central banks के लिए था, आम ग्राहक के लिए नहीं।"
  },
  {
   "beat_id": "b5",
   "say": "Machinery bill कैसे भरें? मान लो French importer ने bank को local payment दिया। Authority ने अपने US$700 में से US$350 दिए; bank ने exporter को चुकाए, authority के US$350 बचे।"
  },
  {
   "beat_id": "b6",
   "say": "Dollar world's reserve currency बना: यानी authorities विदेश के bills भरने लायक assets Dollar में रखती थीं।"
  },
  {
   "beat_id": "b7",
   "say": "Troy ounce gold तौलने की unit है, करीब 31.1 grams; 10 ऐसे ounces करीब 311 grams हैं।"
  },
  {
   "beat_id": "b8",
   "say": "US$35 historical rate है; French transactions teaching examples हैं। Diagram में बीच की जगह और trade की जरूरत Dollar का central role दिखाते हैं।"
  },
  {
   "beat_id": "b9",
   "say": "Gold मिलने का भरोसा confidence देता था; बढ़ते trade को payment balances चाहिए थे। Reserve stock है, payment flow है।"
  },
  {
   "beat_id": "b10",
   "say": "US$350 को US$35 per troy ounce से बाँटें तो 10 troy ounces मिलते हैं। Import payment में gold नहीं मिलता।"
  }
 ],
