 "beats": [
  {
   "beat_id": "b6",
   "say": "अलग सालों के notes को कैसे पहचानोगे? India के 3 major demonetisations हैं: 1946, 1978, 2016। साल के साथ government और notes जोड़ो।"
  },
  {
   "beat_id": "b7",
   "say": "1946 में British India, यानी independence से पहले, ₹500, ₹1,000 और ₹10,000 notes शामिल थे। अगली घटना से फर्क के लिए ₹500 पकड़ो।"
  },
  {
   "beat_id": "b8",
   "say": "1978 में Morarji Desai government ने ₹1,000, ₹5,000, ₹10,000 notes पर फैसला लिया। ध्यान दो: ₹1,000 और ₹10,000 common; 1946 में ₹500, लेकिन 1978 में ₹5,000।"
  },
  {
   "beat_id": "b9",
   "say": "8 November 2016 को PM Narendra Modi का announcement आया: existing ₹500 और ₹1,000 notes midnight से legal tender नहीं रहे। यानी उस समय हाथ में रखे पुराने notes; denomination हमेशा के लिए रोकना नहीं।"
  }
 ],
