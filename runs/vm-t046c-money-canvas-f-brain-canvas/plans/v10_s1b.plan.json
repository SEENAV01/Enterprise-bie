 "beats": [
  {
   "beat_id": "b7",
   "say": "Bank money या Deposit Money यानी खाते में जमा पैसा। किराने में banking instruments से यही पैसा भेजा, हाथ में नोट नहीं दिए।"
  },
  {
   "beat_id": "b8",
   "say": "Negotiable instrument transferable written document है, जिसमें तय रकम चुकाने का promise या order होता है। यानी payment का हक document के साथ आगे जाता है।"
  },
  {
   "beat_id": "b9",
   "say": "Promissory Note यानी लिखकर खुद चुकाने का वादा। Rahul को पैसे देने वाला Maker है; Rahul Payee है, यानी जिसे पैसे मिलने हैं।"
  },
  {
   "beat_id": "b10",
   "say": "Bill of Exchange यानी लिखकर दूसरे से कहना, “पैसे दो।” Wholesaler Drawer, retailer Drawee है। Payee खुद wholesaler या उसका बताया व्यक्ति होगा; इसलिए 3 roles जरूरी नहीं 3 लोग हों।"
  },
  {
   "beat_id": "b11",
   "say": "Cheque bank पर drawn, payable on demand वाला special Bill of Exchange है। यानी bank को payment order है; पेश करके payment माँगते हैं, guarantee नहीं मिलती।"
  },
  {
   "beat_id": "b12",
   "say": "“कुछ पैसे दूँगा” में रकम तय नहीं; केवल बोलने में writing नहीं। खुद देने का promise, दूसरे को order देने से अलग है।"
  },
  {
   "beat_id": "b13",
   "say": "Account में पैसा है; document में payment का promise या order है। आगे इन्हीं के legal rights और parties पहचानेंगे।"
  }
 ],
