 "beats": [
  {
   "beat_id": "b10",
   "say": "₹100 से पहले 5 kg अनाज मिलता था, अब 4 kg—क्या बदला? Price ₹20 से ₹25 per kg हुआ; पैसे उतने ही, सामान कम। Purchasing power यानी पैसे से कितना खरीद सकते हो; यहाँ वह घटी।"
  },
  {
   "beat_id": "b11",
   "say": "मान लो रोजमर्रा की वही चीजें, उतनी ही मात्रा में, पहले ₹100 और अब ₹110 की पड़ती हैं। जब आम तौर पर prices बढ़ने से ऐसा होता है, इसे inflation कहते हैं, यानी general price level का बढ़ना। सिर्फ 1 सब्जी महँगी होना काफी नहीं।"
  },
  {
   "beat_id": "b12",
   "say": "2 packets हों और 10 लोग चाहें—जरूरत के मुकाबले यह कमी scarcity है; price पर ऊपर जाने का दबाव पड़ सकता है। आज ₹500 देने हों, तो cash तैयार है, जमीन तुरंत बेचना कठिन। बिना बड़ी कीमत घटाए asset को खर्च लायक बनाने की आसानी liquidity है; यह कितना खरीद सकते हो, उससे अलग है।"
  }
 ],
