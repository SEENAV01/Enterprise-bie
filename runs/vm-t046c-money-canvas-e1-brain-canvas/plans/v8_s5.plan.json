 "beats": [
  {
   "beat_id": "b29",
   "say": "पुराने Dollar और Pound में क्या साझा था? Bretton Woods का Dollar और British Rule का Pound Sterling metal से जुड़े थे; यानी कागज़ के पीछे metal लेने का रास्ता था।"
  },
  {
   "beat_id": "b30",
   "say": "मान लो चावल ₹20 से ₹25 per kilogram हुए। ₹100 से 5 की जगह 4 kilograms मिलेंगे; पुराने 5 लेने को ₹125 चाहिए। क्या note बदला?"
  },
  {
   "beat_id": "b31",
   "say": "नहीं; face value वही, purchasing power कम है: note inflation adjusted नहीं। Metal redemption अलग अधिकार है; modern note gold या silver weight से linked नहीं।"
  },
  {
   "beat_id": "b32",
   "say": "Currency पर promise है, तो legal promissory note है? नहीं; Section 4 का express exclusion मिलता-जुलता wording होने पर भी category अलग करता है।"
  },
  {
   "beat_id": "b33",
   "say": "Prices बढ़ें तो cash अपने आप नहीं बढ़ता; एक good का example broader inflation नहीं। Bretton Woods में Dollar का gold redemption foreign official holders के लिए था, हर retail bearer के लिए नहीं।"
  },
  {
   "beat_id": "b34",
   "say": "सबसे confusing pair है promise की भाषा और statutory category; exam में bracket वाला exclusion देखो।"
  },
  {
   "beat_id": "b35",
   "say": "चार tests अलग हैं: face value, purchasing power, metal redemption और legal category।"
  }
 ],
