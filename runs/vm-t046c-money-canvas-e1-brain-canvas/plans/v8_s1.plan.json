 "beats": [
  {
   "beat_id": "b1",
   "say": "₹100 का promise क्या हमेशा उतना सामान दिलाता है? Note दिखे नहीं, तो उसकी value कैसे पहचानोगे?"
  },
  {
   "beat_id": "b2",
   "say": "छोटे अंक न दिखें तो? Accessibility Features यानी पहचान आसान बनाने वाली बनावट: raised printing और identification marks छूकर पहचानो; larger numerals और distinct note sizes भी मदद करते हैं।"
  },
  {
   "beat_id": "b3",
   "say": "रोशनी में कौन दिखता है? Watermark में Mahatma Gandhi कागज़ के भीतर दिखते हैं, ऊपर छपा portrait नहीं। Security Thread कागज़ में डाली पतली strip है; उसके भारत, RBI और denomination देखो, सिर्फ dark line नहीं।"
  },
  {
   "beat_id": "b4",
   "say": "Tilt पर चित्र उभरे? Latent Image देखने का angle बदलकर जाँचते हैं। See-through Register में आगे-पीछे के अधूरे निशान रोशनी में पूरी denomination बनाते हैं; यहाँ दोनों faces का alignment जाँचते हो, भीतर बना portrait नहीं।"
  },
  {
   "beat_id": "b5",
   "say": "Lens में छोटी line अक्षर बन जाए तो? Micro-lettering यानी बहुत छोटे अक्षरों में RBI और denomination; crude copy में ये धुँधले मिल सकते हैं। Higher denominations की Optically Variable Ink यानी tilt पर रंग बदलने वाली ink, जैसे चमकीला card घुमाओ; छिपा चित्र उभरना अलग check है।"
  },
  {
   "beat_id": "b6",
   "say": "उँगली से उभार मिले? Intaglio Printing में छपे हिस्से raised होते हैं, पूरा कागज़ नहीं। Number Panels में छोटे से बड़े होते digits trace करो; यह printing-pattern check है, रकम बढ़ना नहीं।"
  },
  {
   "beat_id": "b7",
   "say": "भीतर की बनावट और बारीक छपाई अलग checks देते हैं; Intaglio touch-based पहचान भी देता है।"
  },
  {
   "beat_id": "b8",
   "say": "Checks साथ लगाओ; features denomination और design के साथ बदल सकते हैं।"
  },
  {
   "beat_id": "b9",
   "say": "रास्ता याद रखो: light, tilt, magnify और touch।"
  }
 ],
