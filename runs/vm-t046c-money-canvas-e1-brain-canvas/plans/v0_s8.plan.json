 "beats": [
  {
   "beat_id": "b22",
   "say": "Phone पर ₹100 भरकर button दबाया—क्या app ही पैसा है? App payment interface है, यानी details भरने और काम चुनने की जगह। Pay दबाने पर digital instruction जाता है: किस account से, किसे, कितने पैसे भेजने हैं।"
  },
  {
   "beat_id": "b23",
   "say": "PIN या biometric से पहचान या payment की permission जाँची जाती है; यह authentication है। PIN पैसा नहीं, जाँच का तरीका है। Payment पूरा होने पर accounts में entries होती हैं; हिसाब रखने वाला यह record ledger है, जैसे जमा और खर्च की digital बही।"
  },
  {
   "beat_id": "b24",
   "say": "QR scan करना details पढ़ना हो सकता है, instruction भेजना transfer की माँग है, authentication permission की जाँच है और ledger हिसाब रखता है। इसलिए सिर्फ screenshot या button दब जाना completed payment का प्रमाण नहीं; सही transaction status और account record देखना जरूरी है।"
  },
  {
   "beat_id": "b25",
   "say": "अब खरीद और payment, balance और loan, रकम और purchasing power को अलग रखो। आगे इन्हीं फर्कों से समझेंगे कि Money क्या है और हमारे कौन-से काम करता है।"
  }
 ],
