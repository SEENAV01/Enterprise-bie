 "book_lines": [
  {
   "n": 1,
   "text": "Why are we so interested in the proton gradient?",
   "page": "141",
   "blocks": [
    "p0011-b0019"
   ]
  },
  {
   "n": 2,
   "text": "This gradient is important because it is the breakdown of this gradient that leads to the synthesis of ATP.",
   "page": "141",
   "blocks": [
    "p0011-b0019",
    "p0011-b0020",
    "p0011-b0021"
   ]
  },
  {
   "n": 3,
   "text": "The gradient is broken down due to the movement of protons across the membrane to the stroma through the transmembrane channel of the CF₀ of the ATP synthase.",
   "page": "141",
   "blocks": [
    "p0011-b0021",
    "p0011-b0022",
    "p0012-b0002"
   ]
  },
  {
   "n": 4,
   "text": "The ATP synthase enzyme consists of two parts: one called the CF₀ is embedded in the thylakoid membrane and forms a transmembrane channel that carries out facilitated diffusion of protons across the membrane.",
   "page": "142",
   "blocks": [
    "p0012-b0002",
    "p0012-b0004",
    "p0012-b0006",
    "p0012-b0007"
   ]
  },
  {
   "n": 5,
   "text": "The other portion is called CF₁ and protrudes on the outer surface of the thylakoid membrane on the side that faces the stroma.",
   "page": "142",
   "blocks": [
    "p0012-b0007",
    "p0012-b0009",
    "p0012-b0010"
   ]
  }
 ],
