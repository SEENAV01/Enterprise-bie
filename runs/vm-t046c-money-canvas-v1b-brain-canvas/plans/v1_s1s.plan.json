 "beats": [
  {
   "beat_id": "b2",
   "say": "किराना दुकान में क्या हुआ? ₹100 देकर चावल लिए; cash ₹500 से ₹400 हुआ। फिर ₹50 का पुराना उधार चुकाया; बाकी debt ₹50 से ₹0 हुआ। दोनों payments दुकानदार ने लिए।"
  },
  {
   "beat_id": "b3",
   "say": "₹100 का bill कैसे चुकता हुआ? दुकानदार ने cash लेना चाहा, तो bill ₹100 से ₹0 हुआ। वही ₹10 का सिक्का सब्ज़ी वाले से चाय वाले तक कैसे चला? खराब नहीं हुआ; payments 0 से 2 हुए।"
  },
  {
   "beat_id": "b4",
   "say": "पैसे साथ कैसे ले जाएँगे? Wallet में ₹500 ले गए; ₹200 का किराना लिया, फिर बचे ₹300 लेकर सब्ज़ी वाले तक गए। भारी सामान ढोना नहीं पड़ा।"
  },
  {
   "beat_id": "b5",
   "say": "₹30 के soap के लिए ₹100 दिया, तो कितना बचेगा? ₹70 change मिला। चाय ₹10 की हो और 2 असली ₹10 coins हों, तो कौन-सा देंगे? कोई भी; payment के बाद 1 बचेगा।"
  },
  {
   "beat_id": "b6",
   "say": "इन purchases और repayments में लिया गया payment money है। Money कुछ भी हो सकता है जिसे goods, services के exchange और debts चुकाने में लिया जाए। Medium of exchange यानी देकर सामान या service लेना; settling debts यानी पुराना उधार चुकाना।"
  },
  {
   "beat_id": "b7",
   "say": "Payment लेने की तैयारी Acceptability है। सिक्के का जल्दी खराब न होना Durability है, यानी repeated use में टिकना। पैसे कई हाथों से गुजरते हैं; जल्दी खराब हों तो बार-बार बदलने पड़ेंगे।"
  },
  {
   "beat_id": "b8",
   "say": "आसानी से साथ ले जाना Portability है। ₹100 में से ₹30 देना, ₹70 वापस पाना Divisibility है: value छोटी units में बाँटना। पहली खूबी अलग जगह payment आसान करती है; दूसरी छोटी-बड़ी payment।"
  },
  {
   "beat_id": "b9",
   "say": "कोई भी असली ₹10 coin बराबर चले, यह Uniformity है: equivalent units की value समान। Same denomination समझिए, ₹10 के बदले ₹10। हर coin की अलग कीमत तय नहीं करनी पड़ती।"
  },
  {
   "beat_id": "b10",
   "say": "कीमती चीज़ अपने-आप money नहीं। Acceptability लोगों की willingness है, हर counter पर हर form चलने की guarantee नहीं। Divisibility note के टुकड़े करना नहीं; Uniformity में ₹10 और ₹100 बराबर नहीं।"
  }
 ],
