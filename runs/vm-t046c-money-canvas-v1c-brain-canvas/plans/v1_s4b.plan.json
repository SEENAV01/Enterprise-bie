 "beats": [
  {
   "beat_id": "b26",
   "say": "ये functions हैं Medium of exchange, Unit of account, Store of value और Standard of deferred payment। पहला barter, यानी सामान के बदले सामान, हटाता है। Wheat किसी को बेचें, पैसे से दूसरे से rice लें; matching wants वाला एक partner नहीं ढूँढ़ना पड़ता।"
  },
  {
   "beat_id": "b27",
   "say": "Phone-laptop की तुलना Unit of account है: money value की common measure देती है। यानी अलग चीज़ों की कीमत एक scale में लिखना। Price tag पढ़ना measurement है; payment करना exchange है।"
  },
  {
   "beat_id": "b28",
   "say": "पैसे बाद के लिए रखना Store of value है: purchasing power future use के लिए बचाना। Purchasing power यानी कितना सामान खरीद सकें। Bank account में आज बचाकर बाद के खर्च पूरे करते हैं।"
  },
  {
   "beat_id": "b29",
   "say": "Future dues money में तय करना Standard of deferred payment है। Denominated यानी amount किस unit में लिखा है, जैसे rupees। EMI, equated monthly instalment, loan की तय monthly किस्त है; home loans इसका example हैं।"
  },
  {
   "beat_id": "b30",
   "say": "Store of value perfect guarantee नहीं: prices बढ़ें तो वही balance कम खरीदेगा। सिक्का खराब न होना Durability है, buying power बचना अलग। Savings आपके resources हैं; future instalment obligation है, जिसके पैसे अभी होना ज़रूरी नहीं।"
  },
  {
   "beat_id": "b31",
   "say": "Statement पहचानिए: price बताना account, खरीद चुकाना exchange, पैसे बचाना store, future due तय करना deferred payment। EMI का amount तय करना और बाद में actual payment करना अलग functions दिखाते हैं।"
  },
  {
   "beat_id": "b32",
   "say": "Money की पहचान payment में लिए जाने से है, सिर्फ cash से नहीं। खूबियाँ उसे इस्तेमाल लायक बनाती हैं; functions उसके अलग काम हैं। आगे समझेंगे, सामान के सीधे exchange में परेशानी कहाँ आती है।"
  }
 ],
