{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BIE Enterprise Persisted Run State",
  "type": "object",
  "required": [
    "run_id",
    "run_state",
    "stages"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_state": {
      "enum": [
        "CREATED",
        "ACTIVE",
        "BLOCKED",
        "EXECUTION_COMPLETE"
      ]
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "stage_id",
          "required_predecessors",
          "attempts",
          "events"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "required_predecessors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attempts": {
            "type": "array",
            "minItems": 1
          },
          "events": {
            "type": "array"
          }
        }
      }
    }
  },
  "additionalProperties": false
}