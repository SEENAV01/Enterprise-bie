    "task_id",
    "title",
    "status",
    "system",
    "purpose",
    "dependencies",
    "input_contracts",
    "output_contracts",
    "allowed_files",
    "forbidden_files",
    "test_requirements",
    "acceptance_criteria",
    "evidence"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "IN_PROGRESS",
        "IMPLEMENTED",
        "UNIT_TESTED",
        "INTEGRATION_TESTED",
        "GOLDEN_TESTED",
        "QA_VERIFIED",
        "ACCEPTED",
        "BLOCKED"
