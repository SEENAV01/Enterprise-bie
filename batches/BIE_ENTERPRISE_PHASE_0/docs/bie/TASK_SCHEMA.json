    },
    "system": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "dependencies": {
      "type": "array"
    },
    "input_contracts": {
      "type": "array"
    },
    "output_contracts": {
      "type": "array"
    },
    "allowed_files": {
      "type": "array"
    },
    "forbidden_files": {
      "type": "array"
    },
    "test_requirements": {
      "type": "array"
    },
    "acceptance_criteria": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "array"
    }
