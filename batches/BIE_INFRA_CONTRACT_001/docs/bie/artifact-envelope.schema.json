{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bie.local/schemas/artifact-envelope-1.0.0.json",
  "title": "BIE Artifact Envelope",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "run_id",
    "created_at",
    "producer",
    "content_hash",
    "parent_refs",
    "provenance_summary",
    "metadata",
    "payload"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "required": [
        "component",
        "component_version",
        "execution_kind"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "component_version": {
          "type": "string",
          "minLength": 1
        },
        "execution_kind": {
          "enum": [
            "deterministic",
            "model",
            "human",
            "hybrid"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "provenance_summary": {
      "$ref": "#/$defs/provenanceSummary"
    },
    "metadata": {
      "type": "object"
    },
    "payload": {}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": [
        "artifact_id",
        "artifact_type",
        "schema_version",
        "content_hash"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "artifact_type": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "provenanceSummary": {
      "type": "object",
      "required": [
        "sources",
        "inferred"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "locator"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "locator": {
                "type": "object",
                "minProperties": 1
              },
              "evidence_hash": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quote_hash": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "inferred": {
          "type": "boolean"
        },
        "inference_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}