      "case_id": "BIE-EVAL-BIO-002.C001",
      "inputs": {
        "assortment": "independent",
        "dominance": "complete",
        "loci": [
          {
            "gene": "A",
            "parent_a": "Aa",
            "parent_b": "Aa"
          }
        ],
        "op": "mendelian_cross"
      },
      "expected": {
        "status": "OK",
        "values": {
          "genotype_probabilities": {
            "AA": "1/4",
            "Aa": "1/2",
            "aa": "1/4"
          },
          "phenotype_probabilities": {
            "A_": "3/4",
            "aa": "1/4"
          },
          "probability_sum": "1",
          "profile": "INDEPENDENT_DIPLOID_COMPLETE_DOMINANCE"
        }
      },
      "derivation": "Four equiprobable parental allele pairs aggregate to 1:2:1 genotypes and 3:1 phenotypes."
    },
