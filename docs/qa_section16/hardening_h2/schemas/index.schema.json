{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "bie.qa.h2.index/1",
  "required": [
    "schema_version",
    "checkpoint",
    "latest_task_ids",
    "blueprint_digest",
    "original_tasks",
    "hardening_state",
    "hardening_tasks",
    "namespaces",
    "tests",
    "metadata",
    "historical_evidence_is_not_current_acceptance",
    "github_integrated",
    "section15_modified",
    "product_accepted"
  ],
  "properties": {
    "schema_version": {
      "const": "bie.qa.task-integration-index/1"
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "latest_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blueprint_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_tasks": {
      "type": "array",
      "minItems": 76,
      "maxItems": 76,
      "items": {
        "type": "object"
      }
    },
    "hardening_state": {
      "type": "object"
    },
    "hardening_tasks": {
      "type": "array",
      "minItems": 41,
      "maxItems": 41,
      "items": {
        "type": "object"
      }
    },
    "namespaces": {
      "type": "array",
      "minItems": 22,
      "items": {
        "type": "object"
      }
    },
    "tests": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "historical_evidence_is_not_current_acceptance": {
      "const": true
    },
    "github_integrated": {
      "const": false
    },
    "section15_modified": {
      "const": false
    },
    "product_accepted": {
      "const": false
    }
  }
}
