{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "bie.qa.h2.inventory/1",
  "required": [
    "schema_version",
    "authority_digest",
    "candidate_digest",
    "run_id",
    "revision",
    "created_at",
    "expires_at",
    "artifacts",
    "task_ids",
    "checks",
    "obligations"
  ],
  "properties": {
    "schema_version": {
      "const": "bie.qa.authoritative-inventory/1"
    },
    "authority_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "size",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "subject_type",
          "subject_id",
          "check_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "subject_type": {
            "enum": [
              "gate",
              "section_exit"
            ]
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "check_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "required": [
          "obligation_id",
          "owner",
          "scope",
          "definition_digest",
          "status",
          "closure_ref"
        ],
        "additionalProperties": false,
        "properties": {
          "obligation_id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "definition_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "OPEN",
              "EXTERNAL_PENDING",
              "PARTIALLY_ADDRESSED_OPEN",
              "PENDING",
              "BLOCKED",
              "CLOSED"
            ]
          },
          "closure_ref": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "artifact_id",
                  "path",
                  "sha256",
                  "size",
                  "role"
                ],
                "additionalProperties": false,
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
