        "schema_version",
        "run_id",
        "revision",
        "game_id",
        "inputs_digest",
        "outputs_digest",
        "entrypoint",
        "tool_id",
        "tool_version",
        "started",
        "exit_code",
        "timed_out",
        "issued_at",
        "execution_kind",
