{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/bie_qa_game_v2_models_BuildReceipt",
  "$defs": {
    "bie_qa_game_v2_models_BuildReceipt": {
      "type": "object",
