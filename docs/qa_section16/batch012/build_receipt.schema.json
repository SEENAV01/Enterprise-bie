          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "game_id": {
          "type": "string"
        },
        "inputs_digest": {
          "type": "string"
        },
        "outputs_digest": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string"
        },
        "tool_id": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "started": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer"
        },
        "timed_out": {
          "type": "boolean"
        },
        "issued_at": {
          "type": "integer"
        },
        "execution_kind": {
          "type": "string"
        },
        "stdout": {
          "$ref": "#/$defs/bie_qa_release_v2_contracts_ArtifactRef"
