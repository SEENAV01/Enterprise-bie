    "bie_qa_semantic_v2_models_ReferenceFact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "type": "string"
        },
        "proposition": {
          "$ref": "#/$defs/bie_qa_semantic_v2_models_Proposition"
        },
        "citation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8192
