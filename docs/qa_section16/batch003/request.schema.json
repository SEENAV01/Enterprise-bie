    "bie_qa_semantic_v2_models_CoverageLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "link_id": {
          "type": "string"
        },
        "requirement_id": {
          "type": "string"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8192
        },
        "depth": {
          "type": "integer"
        }
      },
      "required": [
        "link_id",
        "requirement_id",
        "claim_ids",
        "depth"
      ]
