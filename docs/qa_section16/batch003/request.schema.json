        "predicate_id": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/bie_qa_semantic_v2_models_Value"
        },
        "polarity": {
          "type": "string"
        },
        "context": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2,
            "items": false
          },
          "maxItems": 8192
        }
      },
      "required": [
        "entity_id",
        "predicate_id",
        "value",
        "polarity",
        "context"
      ]
    },
    "bie_qa_semantic_v2_models_Value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "lower": {
          "type": "string"
        },
        "upper": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "symbol",
        "lower",
        "upper",
        "unit"
      ]
