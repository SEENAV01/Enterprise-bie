        "snapshot_digest": {
          "type": "string"
        },
        "grantee_id": {
          "type": "string"
        },
        "territories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
        },
        "commercial": {
          "type": "boolean"
        },
        "planned_from": {
          "type": "integer"
        },
        "planned_until": {
          "type": "integer"
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Material"
          },
          "maxItems": 4096
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Grant"
          },
          "maxItems": 4096
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UseRequirement"
          },
          "maxItems": 4096
        },
        "max_receipt_age_seconds": {
          "type": "integer"
        },
        "max_status_age_seconds": {
          "type": "integer"
        }
      },
      "required": [
        "policy_id",
        "snapshot_digest",
        "grantee_id",
        "territories",
        "channels",
        "commercial",
        "planned_from",
        "planned_until",
        "materials",
        "grants",
        "requirements",
        "max_receipt_age_seconds",
        "max_status_age_seconds"
      ],
      "additionalProperties": false
    },
    "Material": {
      "type": "object",
      "properties": {
        "material_id": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "extent_id": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "origin_reference": {
          "type": "string"
        },
        "license_expression": {
          "type": "string"
        },
        "parent_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
