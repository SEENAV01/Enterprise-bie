      "required": [
        "material_id",
        "artifact_id",
        "category",
        "extent_id",
        "origin",
        "origin_reference",
        "license_expression",
        "parent_ids",
        "dimensions"
      ],
      "additionalProperties": false
    },
    "Grant": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string"
        },
        "material_id": {
          "type": "string"
        },
        "license_atom": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "grantor_id": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
        },
        "grantees": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
        },
        "territories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
        },
        "commercial_allowed": {
          "type": "boolean"
        },
        "valid_from": {
          "type": "integer"
        },
        "valid_until": {
          "type": "integer"
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Obligation"
          },
          "maxItems": 4096
        },
        "allowed_output_licenses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
