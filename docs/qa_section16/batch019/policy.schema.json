        "territories",
        "channels",
        "commercial_allowed",
        "valid_from",
        "valid_until",
        "obligations",
        "allowed_output_licenses"
      ],
      "additionalProperties": false
    },
    "Obligation": {
      "type": "object",
      "properties": {
        "obligation_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "required_text": {
          "type": "string"
        }
      },
      "required": [
        "obligation_id",
        "kind",
        "required_text"
      ],
      "additionalProperties": false
    },
    "UseRequirement": {
      "type": "object",
      "properties": {
        "use_id": {
          "type": "string"
        },
        "material_id": {
          "type": "string"
        },
        "output_artifact_id": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
        },
        "output_license": {
          "type": "string"
        },
        "notice_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "use_id",
        "material_id",
        "output_artifact_id",
        "operations",
        "output_license",
        "notice_artifact_ids"
      ],
      "additionalProperties": false
    }
  },
  "description": "Structural schema; Python contracts and evaluator enforce semantics and authorization. No rights are inferred by schema validity."
}
