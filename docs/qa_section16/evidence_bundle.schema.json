{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bie:qa:release:bundle:2.0.0",
  "title": "BIE Section 16 release evidence bundle v2",
  "description": "Wire shape only. Python runtime additionally enforces safe paths, cross-field identities, TTL, authorization, byte verification, coverage and non-production boundaries. The JSON input is limited to 4 MiB.",
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Runtime enforces portable, relative ASCII paths with no empty, . or .. segments."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "role": {
          "enum": [
            "source",
            "video",
            "game",
            "support",
            "report"
          ]
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false
    },
    "ReleaseCandidate": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/ArtifactRef"
              },
              {
                "not": {
                  "properties": {
                    "role": {
                      "const": "report"
                    }
                  },
                  "required": [
                    "role"
                  ]
                }
              }
            ]
          },
          "minItems": 3,
          "maxItems": 2048,
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "role": {
                    "const": "source"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "role": {
                    "const": "video"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "role": {
                    "const": "game"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 1
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "candidate_id",
        "run_id",
        "revision",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "GateEvidence": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "gate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "SKIPPED",
            "NOT_RUN"
          ]
        },
        "evaluator_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "evaluator_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "execution",
            "review",
            "fixture",
            "declaration",
            "historical"
          ]
        },
        "inspected_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1,
          "maxItems": 2048,
          "uniqueItems": true
        },
        "report": {
          "allOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "properties": {
                "role": {
                  "const": "report"
                }
              },
              "required": [
                "role"
              ]
            }
          ]
        },
        "created_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "signer_key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^(|[a-f0-9]{64})$"
        }
      },
      "required": [
        "schema_version",
        "evidence_id",
        "gate_id",
        "candidate_digest",
        "policy_digest",
        "run_id",
        "revision",
        "status",
        "evaluator_id",
        "evaluator_version",
        "kind",
        "inspected_artifact_ids",
        "report",
        "created_at",
        "expires_at",
        "diagnostics",
        "signer_key_id",
        "signature"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "PASS"
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "diagnostics": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "candidate": {
      "$ref": "#/$defs/ReleaseCandidate"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GateEvidence"
      },
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "candidate",
    "evidence"
  ],
  "additionalProperties": false
}
