{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "bie.qa.immutable-fact/1"
    },
    "fact_kind": {
      "const": "artifact_identity"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "role": {
          "enum": [
            "source",
            "video",
            "game",
            "support",
            "report"
          ]
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false
    },
    "justification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    }
  },
  "required": [
    "schema_version",
    "fact_kind",
    "artifact",
    "justification"
  ],
  "additionalProperties": false
}
