{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "bie.qa.terminal-report/1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "FAILED",
        "ERROR",
        "SKIPPED",
        "NOT_RUN",
        "REVIEW_REQUIRED",
        "PENDING",
        "BLOCKED",
        "CONTRACT_ONLY"
      ]
    },
    "scope": {
      "enum": [
        "NATIVE_PRODUCT",
        "DIAGNOSTIC"
      ]
    },
    "binding": {
      "type": "object",
      "properties": {
        "subject_type": {
          "enum": [
            "gate",
            "section_exit"
          ]
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "release_policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluator_policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bundle_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "inspected_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 268435456
              },
              "role": {
                "enum": [
                  "source",
                  "video",
                  "game",
                  "support",
                  "report"
                ]
              }
            },
            "required": [
              "artifact_id",
              "path",
              "sha256",
              "size",
              "role"
            ],
            "additionalProperties": false
          },
          "maxItems": 2048
        }
      },
      "required": [
        "subject_type",
        "subject_id",
        "evidence_id",
        "candidate_digest",
        "run_id",
        "revision",
        "release_policy_digest",
        "evaluator_policy_digest",
        "bundle_digest",
        "inspected_artifacts"
      ],
      "additionalProperties": false
    },
    "captured_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "maxItems": 4096
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "severity": {
            "enum": [
              "ADVISORY",
              "BLOCKING"
            ]
          }
        },
        "required": [
          "code",
          "severity"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "ledgers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          },
          "role": {
            "enum": [
              "source",
              "video",
              "game",
              "support",
              "report"
            ]
          }
        },
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "size",
          "role"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "immutable_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "bie.qa.immutable-fact/1"
          },
          "fact_kind": {
            "const": "artifact_identity"
          },
          "artifact": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 268435456
              },
              "role": {
                "enum": [
                  "source",
                  "video",
                  "game",
                  "support",
                  "report"
                ]
              }
            },
            "required": [
              "artifact_id",
              "path",
              "sha256",
              "size",
              "role"
            ],
            "additionalProperties": false
          },
          "justification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "required": [
          "schema_version",
          "fact_kind",
          "artifact",
          "justification"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "status",
    "scope",
    "binding",
    "captured_at",
    "created_at",
    "expires_at",
    "checks",
    "diagnostics",
    "ledgers",
    "immutable_facts"
  ],
  "additionalProperties": false,
  "$defs": {
    "check": {
      "type": "object",
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "FAILED",
            "ERROR",
            "SKIPPED",
            "NOT_RUN",
            "REVIEW_REQUIRED",
            "PENDING",
            "BLOCKED",
            "CONTRACT_ONLY"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "severity": {
                "enum": [
                  "ADVISORY",
                  "BLOCKING"
                ]
              }
            },
            "required": [
              "code",
              "severity"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "check_id",
        "status",
        "diagnostics",
        "checks"
      ],
      "additionalProperties": false
    }
  }
}
