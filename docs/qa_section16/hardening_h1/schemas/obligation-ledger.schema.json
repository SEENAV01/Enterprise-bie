{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "bie.qa.obligation-ledger/1"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collection_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "obligation_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "status": {
                  "enum": [
                    "CLOSED",
                    "RESOLVED",
                    "VERIFIED_CLOSED",
                    "OPEN",
                    "EXTERNAL_PENDING",
                    "PARTIALLY_ADDRESSED_OPEN",
                    "PENDING",
                    "BLOCKED"
                  ]
                },
                "closure_artifact": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "artifact_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "size": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 268435456
                        },
                        "role": {
                          "enum": [
                            "source",
                            "video",
                            "game",
                            "support",
                            "report"
                          ]
                        }
                      },
                      "required": [
                        "artifact_id",
                        "path",
                        "sha256",
                        "size",
                        "role"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "obligation_id",
                "status",
                "closure_artifact"
              ],
              "additionalProperties": false
            },
            "maxItems": 4096
          }
        },
        "required": [
          "collection_id",
          "items"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    }
  },
  "required": [
    "schema_version",
    "collections"
  ],
  "additionalProperties": false
}
