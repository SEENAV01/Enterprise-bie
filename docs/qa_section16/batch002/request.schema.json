{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Source"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Block"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Output"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "revision",
    "candidate_digest",
    "sources",
    "blocks",
    "outputs",
    "citations",
    "claims"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bie:qa:source:request:1.0.0",
  "$comment": "Wire-shape schema only. Python validation additionally enforces byte limits, safe paths, roles, unique identities/spans, numeric relationships, exact offsets, actual bytes and operator-owned trust. Schema validity is never evidence validity.",
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "role": {
          "type": "string",
          "enum": [
            "source",
            "video",
            "game",
            "support",
            "report"
          ]
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "utf8",
            "pdf",
            "image",
            "epub",
            "docx",
            "html"
          ]
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "source_id",
        "artifact",
        "media_type",
        "page_count"
      ],
      "additionalProperties": false
    },
    "Block": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "region_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "box_ppm": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "minItems": 4,
          "maxItems": 4
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "extractor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "extractor_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "confidence_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "block_id",
        "source_id",
        "source_sha256",
        "page",
        "region_id",
        "box_ppm",
        "text",
        "extractor_id",
        "extractor_version",
        "confidence_ppm"
      ],
      "additionalProperties": false
    },
    "Output": {
      "type": "object",
      "properties": {
        "output_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "channel": {
          "type": "string",
          "enum": [
            "narration",
            "caption",
            "on_screen",
            "game_feedback",
            "game_prompt",
            "lesson"
          ]
        }
      },
      "required": [
        "output_id",
        "artifact",
        "channel"
      ],
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "properties": {
        "citation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "block_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "block_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        }
      },
      "required": [
        "citation_id",
        "block_id",
        "block_digest",
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "output_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "kind": {
          "type": "string",
          "enum": [
            "FACT",
            "QUESTION",
            "INSTRUCTION",
            "OTHER"
          ]
        },
        "citation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "claim_id",
        "output_id",
        "output_sha256",
        "start",
        "end",
        "text",
        "kind",
        "citation_ids"
      ],
      "additionalProperties": false
    }
  }
}
