        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bie_qa_reasoning_v2_models_ConfidenceDecision"
          },
          "maxItems": 8192
        }
      },
      "required": [
        "schema_version",
        "source",
        "events",
        "masteries",
        "statements",
        "steps",
        "arguments",
        "evidence",
        "calibrations",
        "decisions"
      ],
      "additionalProperties": false
    },
