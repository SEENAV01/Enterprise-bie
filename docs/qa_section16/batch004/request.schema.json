      ],
      "additionalProperties": false
    },
    "bie_qa_reasoning_v2_logic_Expr": {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "atom",
            "not",
            "and",
            "or",
            "implies",
            "iff"
          ]
        },
        "atom": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bie_qa_reasoning_v2_logic_Expr"
          },
          "maxItems": 8192
        }
      },
      "required": [
        "op",
        "atom",
        "args"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "atom"
              }
            }
          },
          "then": {
            "properties": {
              "atom": {
                "minLength": 1
              },
              "args": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "atom": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "not"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "and",
                  "or",
                  "implies",
                  "iff"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      ]
    },
