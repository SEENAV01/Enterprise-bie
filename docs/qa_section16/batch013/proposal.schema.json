{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal structural contract (not acceptance)",
  "$ref": "#/$defs/Proposal",
  "$defs": {
    "Proposal": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "base_digest": {
          "type": "string"
        },
        "policy_digest": {
          "type": "string"
        },
        "plan_digest": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "target_failure_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4096
        },
        "replacements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Replacement"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "proposal_id",
        "run_id",
        "revision",
        "base_digest",
        "policy_digest",
        "plan_digest",
        "owner",
        "target_failure_ids",
        "replacements"
      ],
      "additionalProperties": false
    },
    "Replacement": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "before_sha256": {
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "path",
        "before_sha256",
        "artifact"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false
    }
  }
}
