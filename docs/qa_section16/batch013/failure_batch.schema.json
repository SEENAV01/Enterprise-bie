{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FailureBatch structural contract (not acceptance)",
  "$ref": "#/$defs/FailureBatch",
  "$defs": {
    "FailureBatch": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "snapshot_digest": {
          "type": "string"
        },
        "reports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BoundReport"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "run_id",
        "revision",
        "snapshot_digest",
        "reports"
      ],
      "additionalProperties": false
    },
    "BoundReport": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "task_id": {
          "type": "string"
        },
        "request_digest": {
          "type": "string"
        },
        "evaluator_policy_digest": {
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "task_id",
        "request_digest",
        "evaluator_policy_digest"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false
    }
  }
}
