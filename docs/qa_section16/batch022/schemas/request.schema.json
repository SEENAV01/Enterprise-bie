{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "request",
  "description": "Structural validation only; Python contract, byte verification and authority checks remain mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "release_version",
    "bundle",
    "lineage",
    "governance",
    "open_items"
  ],
  "properties": {
    "schema_version": {
      "const": "bie.qa.publication/1"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "release_version": {
      "type": "string",
      "minLength": 1
    },
    "bundle": {
      "type": "object"
    },
    "lineage": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "parent_ids"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    },
    "governance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "size",
          "role"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "const": "report"
          }
        }
      },
      "maxItems": 3
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 2048
    },
    "inventory": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "path",
            "sha256",
            "size",
            "role"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "role": {
              "const": "report"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
