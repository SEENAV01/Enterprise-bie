{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gate-proof",
  "description": "Structural validation only; Python contract, byte verification and authority checks remain mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "gate_id",
    "candidate_digest",
    "policy_digest",
    "run_id",
    "revision",
    "status",
    "scope",
    "checks",
    "source_reports"
  ],
  "properties": {
    "schema_version": {
      "const": "bie.qa.release-proof/1"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "gate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "SKIPPED",
        "NOT_RUN"
      ]
    },
    "scope": {
      "enum": [
        "NATIVE_PRODUCT",
        "DIAGNOSTIC"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "diagnostics"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "ERROR",
              "SKIPPED",
              "NOT_RUN",
              "REVIEW_REQUIRED"
            ]
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "source_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "size",
          "role"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "const": "report"
          }
        }
      },
      "minItems": 1,
      "maxItems": 128
    }
  }
}
