{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PerformanceRequest",
  "type": "object",
  "properties": {
    "snapshot": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "artifact_id",
              "path",
              "sha256",
              "size",
              "role"
            ],
            "additionalProperties": false
          },
          "maxItems": 4096
        }
      },
      "required": [
        "run_id",
        "revision",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "size",
          "role"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    },
    "receipt_id": {
      "type": "string"
    }
  },
  "required": [
    "snapshot",
    "evidence",
    "receipt_id"
  ],
  "additionalProperties": false
}
