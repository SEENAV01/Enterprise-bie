{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "request_digest": {
            "type": "string"
          },
          "policy_digest": {
            "type": "string"
          },
          "evidence_digest": {
            "type": "string"
          },
          "evaluated_at": {
            "type": "integer"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "subject_id": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "severity",
                "subject_id",
                "owner",
                "detail"
              ],
              "additionalProperties": false
            },
            "maxItems": 4096
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "maxItems": 4096
          },
          "inspected_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4096
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4096
          }
        },
        "required": [
          "task_id",
          "request_digest",
          "policy_digest",
          "evidence_digest",
          "evaluated_at",
          "findings",
          "measurements",
          "inspected_artifact_ids",
          "limitations"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    },
    "details_json": {
      "type": "string"
    }
  },
  "required": [
    "reports",
    "details_json"
  ],
  "additionalProperties": false
}
