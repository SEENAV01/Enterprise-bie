{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "snapshot": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "artifact_id",
              "path",
              "sha256",
              "size",
              "role"
            ],
            "additionalProperties": false
          },
          "maxItems": 4096
        }
      },
      "required": [
        "run_id",
        "revision",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "sandbox_evidence": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "size": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            }
          },
          "required": [
            "artifact_id",
            "path",
            "sha256",
            "size",
            "role"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "snapshot",
    "sandbox_evidence"
  ],
  "additionalProperties": false
}
