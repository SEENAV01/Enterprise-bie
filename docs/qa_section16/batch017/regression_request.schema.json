{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegressionRequest structural contract (not acceptance)",
  "$ref": "#/$defs/RegressionRequest",
  "$defs": {
    "RegressionRequest": {
      "type": "object",
      "properties": {
        "comparison_id": {
          "type": "string"
        },
        "baseline": {
          "$ref": "#/$defs/Snapshot"
        },
        "candidate": {
          "$ref": "#/$defs/Snapshot"
        },
        "execution": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "comparison_id",
        "baseline",
        "candidate",
        "execution"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "run_id",
        "revision",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false
    }
  }
}
