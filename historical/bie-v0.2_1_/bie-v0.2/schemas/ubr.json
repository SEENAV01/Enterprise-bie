{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bie.local/schemas/ubr.json",
  "title": "Universal Book Representation",
  "type": "object",
  "required": ["book_id", "metadata", "structure", "information_units", "relationships"],
  "properties": {
    "book_id": {"type": "string"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "structure": {"$ref": "#/$defs/structure"},
    "information_units": {"type": "array", "items": {"$ref": "#/$defs/informationUnit"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "figures": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "tables": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "equations": {"type": "array", "items": {"$ref": "#/$defs/equation"}},
    "validation": {"type": "object"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string"},
        "authors": {"type": "array", "items": {"type": "string"}},
        "subject": {"type": "string"},
        "edition": {"type": "string"},
        "language": {"type": "string"}
      }
    },
    "structure": {
      "type": "object",
      "required": ["chapters"],
      "properties": {
        "chapters": {"type": "array", "items": {"$ref": "#/$defs/chapter"}}
      }
    },
    "chapter": {
      "type": "object",
      "required": ["id", "title", "sections"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}}
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"},
        "pages": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "informationUnit": {
      "type": "object",
      "required": ["id", "type", "content", "source", "confidence"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "array", "items": {"type": "string"}},
        "content": {"type": "object"},
        "questions": {"type": "array", "items": {"type": "string"}},
        "entities": {"type": "array", "items": {"type": "string"}},
        "relations": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "applications": {"type": "array", "items": {"type": "object"}},
        "source": {"$ref": "#/$defs/source"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "validation": {"type": "object"}
      }
    },
    "relationship": {
      "type": "object",
      "required": ["source", "relation", "target", "confidence"],
      "properties": {
        "source": {"type": "string"}, "relation": {"type": "string"}, "target": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      }
    },
    "source": {
      "type": "object",
      "required": ["page"],
      "properties": {
        "page": {"type": "integer", "minimum": 1}, "chapter": {"type": "string"}, "section": {"type": "string"},
        "block_id": {"type": "string"}, "char_start": {"type": "integer"}, "char_end": {"type": "integer"}
      }
    },
    "asset": {"type": "object", "required": ["id", "source"], "properties": {"id": {"type": "string"}, "source": {"$ref": "#/$defs/source"}, "caption": {"type": "string"}}},
    "equation": {"type": "object", "required": ["id", "latex", "source"], "properties": {"id": {"type": "string"}, "latex": {"type": "string"}, "source": {"$ref": "#/$defs/source"}}}
  }
}
