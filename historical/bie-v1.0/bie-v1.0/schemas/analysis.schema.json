{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BIE v1 Analysis",
  "type": "object",
  "required": [
    "book_id",
    "units",
    "frontier",
    "quality"
  ],
  "properties": {
    "book_id": {
      "type": "string"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "kind",
          "question_types",
          "source_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "question_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "frontier": {
      "type": "object",
      "required": [
        "backward",
        "forward",
        "application"
      ],
      "properties": {
        "backward": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "forward": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "application": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "coverage",
        "provenance",
        "needs_review"
      ],
      "properties": {
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "provenance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_review": {
          "type": "boolean"
        }
      }
    }
  }
}