{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "title",
    "source_refs",
    "claims",
    "question_matrix",
    "definitions",
    "processes",
    "causes",
    "time_place",
    "people_entities",
    "applications",
    "derivations",
    "higher_knowledge_candidates",
    "dependencies",
    "uncertainties",
    "confidence",
    "review_required"
  ],
  "properties": {
    "unit_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "evidence_refs",
          "status"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "GROUNDED",
              "UNCERTAIN",
              "UNSUPPORTED"
            ]
          }
        }
      }
    },
    "question_matrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "what": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "how": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "where": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "who": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derivation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "application": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "time_place": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "people_entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derivations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "higher_knowledge_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "status"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "CANDIDATE",
              "EXTERNAL_RESEARCH"
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_unit",
          "relation",
          "confidence"
        ],
        "properties": {
          "target_unit": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_required": {
      "type": "boolean"
    }
  }
}