# Required for real OpenAI execution
OPENAI_API_KEY=

# OpenAI model used by the BIE provider / Agent SDK
BIE_OPENAI_MODEL=gpt-5.6-luna
BIE_AGENT_MODEL=gpt-5.6-luna

# Optional
BIE_OPENAI_TIMEOUT=120
BIE_OPENAI_MAX_OUTPUT_TOKENS=12000
PORT=8080
# Set BIE_MOCK=1 only for local mock testing
BIE_MOCK=0
