{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BIE M4 Knowledge & Learning Graph",
  "type": "object",
  "required": [
    "book_id",
    "nodes",
    "edges",
    "frontiers",
    "learning_graph",
    "validation"
  ],
  "properties": {
    "book_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "frontiers": {
      "type": "object",
      "required": [
        "backward",
        "forward",
        "application"
      ],
      "properties": {
        "backward": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forward": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "application": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "learning_graph": {
      "type": "object",
      "required": [
        "ordered_nodes",
        "levels"
      ],
      "properties": {
        "ordered_nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "levels": {
          "type": "object"
        }
      }
    },
    "validation": {
      "type": "object"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "label",
        "scope",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "BOOK_INTERNAL",
            "BOOK_PREREQUISITE",
            "EXTERNAL_EXTENSION",
            "EXTERNAL_APPLICATION",
            "HIGHER_LEVEL",
            "MODERN_DEVELOPMENT"
          ]
        },
        "kind": {
          "enum": [
            "concept",
            "fact",
            "definition",
            "process",
            "mechanism",
            "derivation",
            "application",
            "theory",
            "method",
            "technology",
            "skill",
            "domain",
            "question"
          ]
        },
        "depth": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "source",
        "relation",
        "target",
        "confidence",
        "evidence"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "IS_A",
            "PART_OF",
            "HAS_PART",
            "REQUIRES",
            "PREREQUISITE_OF",
            "CAUSES",
            "CAUSE_OF",
            "LEADS_TO",
            "RESULTS_IN",
            "DERIVED_FROM",
            "DEPENDS_ON",
            "EXPLAINS",
            "EXAMPLE_OF",
            "COUNTEREXAMPLE_OF",
            "APPLIED_IN",
            "USED_FOR",
            "SUPPORTED_BY",
            "EVIDENCED_BY",
            "CONTRASTS_WITH",
            "GENERALIZES",
            "SPECIALIZES",
            "ENABLES",
            "LIMITED_BY",
            "EXCEPTION_TO",
            "PRECEDES",
            "FOLLOWS",
            "EXTENDS_TO"
          ]
        },
        "target": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}