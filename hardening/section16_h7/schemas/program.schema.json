{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bie.qa.h7.program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program_id",
    "argv",
    "executable_sha256",
    "script_path",
    "script_sha256",
    "timeout_seconds",
    "max_log_bytes"
  ],
  "properties": {
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "argv": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "script_path": {
      "type": "string",
      "minLength": 1
    },
    "script_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "max_log_bytes": {
      "type": "integer",
      "minimum": 256,
      "maximum": 8388608
    }
  }
}
