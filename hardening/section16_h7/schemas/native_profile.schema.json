{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bie.qa.h7.native_profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkout_rows",
    "worker_sha256",
    "launcher_sha256",
    "timeout_seconds"
  ],
  "properties": {
    "checkout_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "worker_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "launcher_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 595
    }
  }
}
