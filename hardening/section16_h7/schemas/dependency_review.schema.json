{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bie.qa.h7.dependency_review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_digest",
    "created_at",
    "expires_at",
    "snapshot_kind",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "const": "bie.qa.dependency-review/1"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot_kind": {
      "enum": [
        "SYNTHETIC",
        "INDEPENDENT_REVIEW"
      ]
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package_id",
          "version",
          "status",
          "advisory_ids"
        ],
        "properties": {
          "package_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "AFFECTED",
              "UNKNOWN",
              "NO_KNOWN_FINDINGS"
            ]
          },
          "advisory_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
