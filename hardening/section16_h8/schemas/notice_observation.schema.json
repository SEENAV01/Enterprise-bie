{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "notice_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "VIDEO",
        "GAME",
        "TEXT",
        "SOURCE_OFFER"
      ]
    },
    "output_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "capture": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "visible": {
      "type": "boolean"
    },
    "location": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "notice_id",
    "channel",
    "output_artifact_id",
    "output_sha256",
    "text",
    "capture",
    "method",
    "visible",
    "location"
  ],
  "additionalProperties": false
}
