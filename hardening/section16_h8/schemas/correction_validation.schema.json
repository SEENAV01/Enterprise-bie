{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "bie.qa.correction-validation/1"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "before_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "after_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "after": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          }
        },
        "required": [
          "case_id",
          "before",
          "after"
        ],
        "additionalProperties": false
      }
    },
    "conditions_preserved": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "source_sha256",
    "before_sha256",
    "after_sha256",
    "revision",
    "cases",
    "conditions_preserved"
  ],
  "additionalProperties": false
}
