{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bie:qa:h6:repair-content:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "bie.qa.repair-content/1"
    },
    "domain": {
      "enum": [
        "reasoning",
        "pedagogy",
        "director"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "size",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "maxItems": 4096
          },
          "objective_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "maxItems": 4096
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "maxItems": 4096
          }
        },
        "required": [
          "record_id",
          "text",
          "source_ids",
          "objective_ids",
          "conditions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "domain",
    "sources",
    "records"
  ],
  "additionalProperties": false
}
