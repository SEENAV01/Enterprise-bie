{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bie:qa:h6:owned-module:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "bie.qa.owned-module/1"
    },
    "binding": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "run_id",
        "revision",
        "candidate_digest",
        "policy_digest"
      ],
      "additionalProperties": false
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "module": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false
    },
    "emitter": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false
    },
    "source_ir": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "before_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "slot_id",
          "start",
          "end",
          "before_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "binding",
    "owner",
    "module",
    "emitter",
    "source_ir",
    "recipe",
    "slots"
  ],
  "additionalProperties": false
}
