{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bie:qa:h6:access-observation:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "bie.qa.output-accessibility/1"
    },
    "binding": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "run_id",
        "revision",
        "candidate_digest",
        "policy_digest"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "mode": {
      "enum": [
        "NATIVE_OUTPUT",
        "TRUSTED_STATIC_DIAGNOSTIC",
        "SYNTHETIC_OBSERVATION"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "size",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "viewport_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "measured_axes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "maxItems": 4096
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "control_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "name": {
                  "type": "string"
                },
                "keyboard_reached": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "focus_indicator": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "visible": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "contrast": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "control_id",
                "name",
                "keyboard_reached",
                "focus_indicator",
                "visible",
                "contrast"
              ],
              "additionalProperties": false
            },
            "maxItems": 512
          },
          "meanings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "meaning_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "non_color_label": {
                  "type": "string"
                }
              },
              "required": [
                "meaning_id",
                "non_color_label"
              ],
              "additionalProperties": false
            }
          },
          "captions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "caption_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "visible": {
                  "type": "boolean"
                },
                "start_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "contrast": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "caption_id",
                "text",
                "visible",
                "start_ms",
                "end_ms",
                "contrast"
              ],
              "additionalProperties": false
            }
          },
          "motion": {
            "type": "object",
            "properties": {
              "observed": {
                "type": "boolean"
              },
              "mode": {
                "enum": [
                  "standard",
                  "reduced",
                  "unknown"
                ]
              },
              "meaning_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "maxItems": 4096
              }
            },
            "required": [
              "observed",
              "mode",
              "meaning_ids"
            ],
            "additionalProperties": false
          },
          "flash": {
            "type": "object",
            "properties": {
              "full_output_observed": {
                "type": "boolean"
              },
              "screening": {
                "enum": [
                  "CLEAR",
                  "FAIL",
                  "UNKNOWN"
                ]
              },
              "frame_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "full_output_observed",
              "screening",
              "frame_count"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "viewport_id",
          "measured_axes",
          "controls",
          "meanings",
          "captions",
          "motion",
          "flash"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "binding",
    "created_at",
    "execution_id",
    "mode",
    "artifacts",
    "views"
  ],
  "additionalProperties": false
}
