{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bie:qa:h6:corpus-policy:1",
  "type": "object",
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "tree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "suite_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "directory": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "suite_id",
          "directory"
        ],
        "additionalProperties": false
      }
    },
    "evidence_kind": {
      "enum": [
        "DIAGNOSTIC_REPOSITORY",
        "CANONICAL_CHECKOUT"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "max_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    }
  },
  "required": [
    "repository",
    "revision",
    "tree",
    "suites",
    "evidence_kind",
    "timeout_seconds",
    "max_files"
  ],
  "additionalProperties": false
}
