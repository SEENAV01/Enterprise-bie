{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "bie.task-card/1",
 "title": "BIE task card",
 "description": "The compact, variable part of every instruction BIE sends to a maker or reviewer AI (docs/roadmap/TASK_CARD.md). The fixed part (role, course, rule texts, content types, output schema) is the cached prefix named in 'prefix'. Uses only the JSON-schema subset that BIE's own validator enforces (bie/model_gateway/schema_validation.py, strict). Designed in Task 043; implemented in Task 045 (bie/brain/cards.py).",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "card",
  "card_id",
  "section",
  "task",
  "prefix",
  "unit",
  "parts",
  "rules",
  "output",
  "coverage",
  "context",
  "source"
 ],
 "properties": {
  "card": {
   "type": "string",
   "enum": [
    "bie.task-card/1"
   ]
  },
  "card_id": {
   "type": "string",
   "minLength": 3,
   "description": "<section>.<task>@<chapter id>/<unit id>, unique in a run"
  },
  "section": {
   "type": "string",
   "enum": [
    "understand",
    "connect",
    "lesson",
    "director",
    "visual",
    "game",
    "notes",
    "review"
   ]
  },
  "task": {
   "type": "string",
   "enum": [
    "read_page",
    "build_chapter_map",
    "plan_videos",
    "write_script",
    "direct_scenes",
    "plan_assets",
    "choose_asset",
    "lay_out_scene",
    "design_game",
    "build_mission",
    "write_notes",
    "review"
   ]
  },
  "prefix": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "prefix_id",
    "rulebook_version",
    "content_types_version",
    "schema_id",
    "sha256"
   ],
   "description": "Which fixed prefix this card goes with; the prefix text is sent once per call as the system message and is identical for every card of the same section and task in a run, so providers can cache it.",
   "properties": {
    "prefix_id": {
     "type": "string",
     "minLength": 3
    },
    "rulebook_version": {
     "type": "string",
     "minLength": 3
    },
    "content_types_version": {
     "type": "string",
     "minLength": 3
    },
    "schema_id": {
     "type": "string",
     "minLength": 3
    },
    "sha256": {
     "type": "string",
     "minLength": 64,
     "maxLength": 64
    }
   }
  },
  "unit": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "unit_id",
    "title",
    "pages"
   ],
   "properties": {
    "unit_id": {
     "type": "string",
     "minLength": 1
    },
    "title": {
     "type": "string"
    },
    "pages": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    }
   }
  },
  "parts": {
   "type": "array",
   "minItems": 1,
   "description": "What this unit must deal with, part by part: each part has its content type and the teacher questions it must answer.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "part_id",
     "item_ids",
     "type",
     "questions",
     "focus"
    ],
    "properties": {
     "part_id": {
      "type": "string",
      "minLength": 1
     },
     "item_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      },
      "description": "Chapter-map item ids; concept ids on a plan_videos card; native text block ids (and 'pNNNN-image' for the page image) on a read_page card."
     },
     "type": {
      "type": "string",
      "enum": [
       "process",
       "structure",
       "classification",
       "comparison",
       "timeline",
       "cause_effect",
       "facts_numbers",
       "figure",
       "definition",
       "none"
      ],
      "description": "The content type of the part; 'none' only on a read_page card where BIE's code has no proposal for these blocks (the maker decides)."
     },
     "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "enum": [
        "what",
        "about",
        "where",
        "how",
        "when",
        "who",
        "whom",
        "which",
        "why",
        "compare",
        "difference",
        "evidence",
        "exception",
        "consequence"
       ]
      }
     },
     "focus": {
      "type": "string",
      "minLength": 1,
      "description": "One line: what this part must achieve for the learner."
     }
    }
   }
  },
  "rules": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   },
   "description": "Rule ids that apply to this card; their texts are in the prefix."
  },
  "output": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema_id",
    "mode",
    "max_output_tokens"
   ],
   "properties": {
    "schema_id": {
     "type": "string",
     "minLength": 3
    },
    "mode": {
     "type": "string",
     "enum": [
      "full",
      "patch"
     ]
    },
    "max_output_tokens": {
     "type": "integer"
    }
   }
  },
  "coverage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "must_cover",
    "claim_field",
    "may_skip"
   ],
   "description": "Every id in must_cover has to be claimed in the output field named by claim_field; BIE's code checks it.",
   "properties": {
    "must_cover": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Ids the answer must claim in claim_field: block ids (read_page), item ids (build_chapter_map, write_script) or concept ids (plan_videos)."
    },
    "claim_field": {
     "type": "string",
     "minLength": 1
    },
    "may_skip": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "item_id",
       "reason"
      ],
      "properties": {
       "item_id": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "context": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "map_slice",
    "before",
    "after"
   ],
   "description": "Only the slice of the compact chapter map this unit needs, plus one line on what comes before and after.",
   "properties": {
    "map_slice": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
       "type": "string"
      }
     },
     "description": "Rows of [item id, content type, page, short text] from the compact chapter map."
    },
    "before": {
     "type": "string"
    },
    "after": {
     "type": "string"
    }
   }
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "block_ids",
    "page_images"
   ],
   "description": "References only; the page images travel as image parts after the card and are recorded by hash.",
   "properties": {
    "block_ids": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "page_images": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "page",
       "sha256"
      ],
      "properties": {
       "page": {
        "type": "integer"
       },
       "sha256": {
        "type": "string"
       }
      }
     }
    }
   }
  }
 }
}
