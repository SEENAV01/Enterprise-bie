{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "bie.toolbox.registry/1",
 "title": "BIE toolbox registry (Task 046a)",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "version", "npm_before", "statuses", "tools"],
 "properties": {
  "schema": {"const": "bie.toolbox.registry/1"},
  "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"},
  "npm_before": {"type": "string"},
  "note": {"type": "string"},
  "statuses": {"type": "array", "items": {"type": "string"}},
  "tools": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "kind", "subjects", "content_types", "capabilities", "role", "path", "version", "licence",
                 "licence_flags", "source", "install_group", "status", "batch", "notes"],
    "properties": {
     "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,60}$"},
     "name": {"type": "string", "minLength": 2},
     "kind": {"type": "string", "enum": ["python_lib", "js_lib", "asset_source", "dataset", "app"]},
     "subjects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
     "content_types": {"type": "array", "items": {"type": "string"}},
     "capabilities": {"type": "array", "items": {"type": "string"}},
     "role": {"type": "string", "enum": ["compute", "draw", "offline_render", "asset"]},
     "path": {"type": "string", "enum": ["web", "python", "offline"]},
     "version": {"type": "string", "minLength": 1},
     "licence": {"type": "string", "minLength": 2},
     "licence_flags": {"type": "array", "items": {"type": "string", "enum": ["share_alike", "gpl", "custom", "per_item", "non_commercial"]}},
     "source": {"type": "string", "pattern": "^https://"},
     "install_group": {"type": "string", "minLength": 2},
     "status": {"type": "string", "enum": ["installed", "wrapped", "demo_proven", "used_on_real_book", "blocked_with_reason"]},
     "batch": {"type": "integer", "minimum": 1, "maximum": 3},
     "notes": {"type": "string"},
     "adapter": {"type": "string"},
     "block": {"type": "string"},
     "levels": {"type": "array", "items": {"type": "string"}},
     "rank": {"type": "integer"},
     "proof": {"type": "object", "additionalProperties": false, "properties": {"demos": {"type": "array", "items": {"type": "string"}},
                                                                                 "tests": {"type": "array", "items": {"type": "string"}}}},
     "blocked_reason": {"type": "string"}
    }
   }
  }
 }
}
