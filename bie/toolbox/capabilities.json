 "grammar_blocks": {
  "note": "blocks the shot-list director may add to any shot, whatever its capability, because a grammar rule asks for them",
  "blocks": {
   "leader_label": "VG-02 labels as code text with a leader line",
   "kinetic_caption": "B-08 the spoken words on top",
   "focus_glow": "B-10 the one structure the sentence is about is lit",
   "camera_path": "VG-01 the camera moves to the next part",
   "cutaway": "VG-03 inside shown by cutting",
   "exploded_view": "VG-03 inside shown by opening",
   "scale_compare": "VG-04 size against a known thing",
   "split_compare": "VG-07 two things side by side",
   "flow_arrows": "VG-08 a process moves",
   "equation_steps": "VG-05 equations build step by step",
   "graph_plot": "VG-06 graphs draw themselves",
   "timeline": "VG-10 history on a lit timeline",
   "board_build": "B-07 one summary line per member on a board that fills",
   "mnemonic_card": "the memory beat",
   "concept_arrow": "B-06 the reason behind a name, A → B"
  }
 },
