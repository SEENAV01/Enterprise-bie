#!/bin/bash
# One-time steps for Navin on the BIE machine: Claude as BIE's script writer (Navin, 26 November 2026: "tumhe hi script
# writing ke kaam mein baitha deta hun vm ke raaste se"). Run: sudo bie-claude-setup
#
# 1. installs Anthropic's Claude Code CLI (pinned, run unmodified; used under Anthropic's terms with Navin's own Claude
#    plan: one person's own work on his own machine, never resold or shared);
# 2. signs it in with Navin's Claude account (a link to open on the tablet and a code to paste back; no API key is ever
#    used, and BIE removes ANTHROPIC_API_KEY from the writer's environment); the sign-in stays in /var/lib/bie/claude
#    (mode 700, owner bie), like Codex's in /var/lib/bie/codex;
# 3. keeps the key of the taught chat's locked copy (/var/lib/bie/claude/chat.key, mode 600, owner bie); BIE's "copy" job
#    installs each copy as /var/lib/bie/claude/BASE_SESSION, so every script job starts from that chat's memory (a fork
#    of it); a script job refuses to start without it unless the job says "fresh": true.
set -euo pipefail
CLAUDE_VERSION="2.1.331"
BIE_HOME="${BIE_HOME:-/var/lib/bie}"
CONF="$BIE_HOME/claude"
if [ "$(id -u)" != "0" ]; then echo "Aise chalaiye: sudo bie-claude-setup"; exit 1; fi

echo "== 1/3 Claude Code install (version $CLAUDE_VERSION) =="
if command -v claude >/dev/null 2>&1 && claude --version 2>/dev/null | grep -q "$CLAUDE_VERSION"; then
  echo "Claude Code pehle se laga hai."
else
  npm install -g --no-audit --no-fund "@anthropic-ai/claude-code@${CLAUDE_VERSION}" >/dev/null
fi
claude --version
install -d -o bie -g bie -m 700 "$CONF"

echo "== 2/3 Claude sign-in (aapka Claude plan) =="
run_claude() { sudo -u bie env -u ANTHROPIC_API_KEY CLAUDE_CONFIG_DIR="$CONF" HOME="$BIE_HOME" claude "$@"; }
if run_claude auth status >/dev/null 2>&1; then
  echo "Claude pehle se signed in hai."
else
  echo "Neeche ek link aayega. Use tablet par kholiye, apne Claude account se login kijiye, aur jo code mile use yahan daaliye."
  run_claude auth login
fi
run_claude auth status --text || { echo "Sign-in nahi hua. Dobara chalaiye: sudo bie-claude-setup"; exit 1; }
chmod -R go-rwx "$CONF"

echo "== 3/3 Seekhi hui chat ki copy: chabi =="
# The chat Navin taught comes as a locked copy of its own file (Navin, 27 November 2026, "Raasta 1"; teleport cannot
# bring a chat started in the Claude app). Its key stays only here; BIE's "copy" job downloads, unlocks, tests and
# installs each copy (tools/vm_claude.py).
if [ -s "$CONF/chat.key" ]; then
  echo "Chabi pehle se rakhi hai."
else
  echo "Claude ne jo chabi di hai use yahan chipkaiye (screen par dikhegi nahi), phir Enter."
  read -rsp "Chabi: " key || key=""
  echo
  if [ -n "$key" ]; then
    printf '%s\n' "$key" > "$CONF/chat.key"
    chown bie:bie "$CONF/chat.key"; chmod 600 "$CONF/chat.key"
    echo "Chabi rakh di."
  else
    echo "Chabi nahi mili; baad mein yahi setup dobara chalaiye."
  fi
fi
# Claude Code deletes chats older than 30 days by itself; the copies must stay, so that limit is lifted here. The jobs'
# folder is marked trusted, so a job never stops at the folder question.
sudo -u bie python3 - "$CONF" "$BIE_HOME/repo" <<'PY'
import json, os, sys
conf, repo = sys.argv[1], sys.argv[2]
path = os.path.join(conf, "settings.json")
settings = json.load(open(path)) if os.path.exists(path) else {}
settings["cleanupPeriodDays"] = 36500
json.dump(settings, open(path, "w"), indent=2)
path = os.path.join(conf, ".claude.json")
config = json.load(open(path)) if os.path.exists(path) else {}
config.setdefault("projects", {}).setdefault(repo, {})["hasTrustDialogAccepted"] = True
config["hasCompletedOnboarding"] = True
json.dump(config, open(path, "w"), indent=2)
PY
if [ -s "$CONF/BASE_SESSION" ]; then
  echo "Copy lagi hui hai: $(cat "$CONF/BASE_SESSION")"
else
  echo "Copy abhi nahi lagi; Claude ka bheja 'copy' job use lagayega."
fi
echo
echo "Ho gaya. Ab job mein \"maker\": \"claude\" likhne par script Claude likhega."
