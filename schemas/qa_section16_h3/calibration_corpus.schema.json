{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "domain",
    "language",
    "rubric_digest",
    "created_at",
    "training_source_hashes",
    "cases",
    "provenance_mode"
  ],
  "properties": {
    "schema_version": {
      "const": "bie.qa.calibration-corpus/1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "rubric_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    },
    "training_source_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "source_sha256",
          "input_sha256",
          "split",
          "labels",
          "blind_id"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "split": {
            "enum": [
              "train",
              "holdout"
            ]
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "minProperties": 1
          },
          "blind_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "provenance_mode": {
      "enum": [
        "diagnostic",
        "independent"
      ]
    }
  }
}
