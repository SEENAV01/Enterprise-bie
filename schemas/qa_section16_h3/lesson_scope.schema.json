{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "learner_id",
    "binding",
    "routes",
    "source_claim_ids",
    "applicability"
  ],
  "properties": {
    "schema_version": {
      "const": "bie.qa.native-lesson-scope/1"
    },
    "learner_id": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "revision",
        "candidate_digest",
        "policy_digest"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "concept_order"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "minLength": 1
          },
          "concept_order": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 1024
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    },
    "source_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "decision",
          "source_claim_ids",
          "rationale"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "APPLICABLE",
              "NOT_APPLICABLE_REQUESTED"
            ]
          },
          "source_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 4096
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0,
      "maxItems": 128
    }
  }
}
