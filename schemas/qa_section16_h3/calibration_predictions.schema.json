{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_sha256",
    "policy_digest",
    "raters",
    "predictions"
  ],
  "properties": {
    "schema_version": {
      "const": "bie.qa.calibration-predictions/1"
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rater_id",
          "model_version",
          "principal",
          "independence_group"
        ],
        "properties": {
          "rater_id": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "principal": {
            "type": "string",
            "minLength": 1
          },
          "independence_group": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 2,
      "maxItems": 8
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "rater_id",
          "scores"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "rater_id": {
            "type": "string",
            "minLength": 1
          },
          "scores": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 32768
    }
  }
}
