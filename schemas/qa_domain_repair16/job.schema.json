{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "job",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "task_id": {
      "enum": [
        "BIE-QA-REPAIR-004",
        "BIE-QA-REPAIR-005",
        "BIE-QA-REPAIR-006",
        "BIE-QA-REPAIR-007"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "path": {
          "type": "string",
          "pattern": "^generated/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "const": "support"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ]
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "batch_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repair_policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "domain_policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "limits_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "job_id",
    "task_id",
    "target",
    "snapshot_digest",
    "batch_digest",
    "repair_policy_digest",
    "domain_policy_digest",
    "limits_digest"
  ]
}
