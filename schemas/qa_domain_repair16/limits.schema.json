{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "limits",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "max_proof_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "max_total_logic_visits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000000
    },
    "max_added_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600000
    },
    "max_generated_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    }
  },
  "required": [
    "max_proof_calls",
    "max_total_logic_visits",
    "max_added_ms",
    "max_generated_bytes"
  ]
}
