{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BIE deterministic grounded inference 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "schema_version",
    "task_id",
    "operation",
    "status",
    "inputs",
    "value",
    "evidence_refs",
    "assumptions",
    "uncertainty",
    "confidence",
    "requires_review"
  ],
  "properties": {
    "result_id": {
      "type": "string",
      "pattern": "^reasoning\\.inference:1\\.0\\.0:[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "RESOLVED",
        "AMBIGUOUS",
        "CONFLICT",
        "UNREACHABLE"
      ]
    },
    "inputs": {
      "type": "object"
    },
    "value": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "role",
          "strength"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "primary",
              "supporting",
              "contradicting",
              "prerequisite",
              "example",
              "constraint",
              "derived"
            ]
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_review": {
      "type": "boolean"
    }
  }
}
