{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:bie:qa:h4:request",
  "description": "Mode-specific policy fields are checked by runtime constructors.",
  "properties": {
    "binding": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "run_id",
        "revision",
        "candidate_digest",
        "policy_digest"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "required_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_cases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "max_dimension": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "max_absolute_tolerance": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "required_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "binding",
    "artifact",
    "policy"
  ]
}
