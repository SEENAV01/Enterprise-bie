{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:bie:qa:h4:hard016:input",
  "description": "Structural boundary only. Runtime enforces per-kind fields, native digests, time, inventory and source bytes.",
  "properties": {
    "schema_version": {
      "const": "bie.qa.domain-quality-input/1"
    },
    "task_id": {
      "const": "BIE-QA-HARD-016"
    },
    "binding": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "run_id",
        "revision",
        "candidate_digest",
        "policy_digest"
      ],
      "additionalProperties": false
    },
    "native_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object"
      }
    },
    "ratings": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000
      }
    },
    "rated_at": {
      "type": "integer",
      "minimum": 0
    },
    "provenance_mode": {
      "enum": [
        "diagnostic",
        "observed"
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "binding",
    "native_digest",
    "timeline",
    "ratings",
    "rated_at",
    "provenance_mode"
  ]
}
